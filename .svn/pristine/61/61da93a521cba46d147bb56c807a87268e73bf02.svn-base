<?php

class StatusReviewController extends Controller {

    public function filters() {
        return array(
            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'summary') {
            if (!(Yii::app()->user->checkAccess('statusReviewCreate')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }

    public function actionSummary() {
        $saleHeader = Search::bind(new SaleHeader(), isset($_GET['SaleHeader']) ? $_GET['SaleHeader'] : '');
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';
        
        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }

        $saleHeaderDataProvider = $saleHeader->resetScope()->searchWithPaging();
        $saleHeaderDataProvider->criteria->with = array(
            'customer:resetScope',
        );

        $saleHeaderDataProvider->criteria->addCondition("customer.company LIKE :company AND t.date > '2021-12-31'");
        $saleHeaderDataProvider->criteria->params[':company'] = "%{$customerCompany}%";

        $startDate = (isset($_GET['StartDate'])) ? $_GET['StartDate'] : '';
        $endDate = (isset($_GET['EndDate'])) ? $_GET['EndDate'] : '';

        if ($startDate != '' || $endDate != '') {
            $startDate = (empty($startDate)) ? date('Y-m-d') : $startDate;
            $endDate = (empty($endDate)) ? date('Y-m-d') : $endDate;

            $saleHeaderDataProvider->criteria->addBetweenCondition('t.date', $startDate, $endDate);
        }

        $saleHeaderDataProvider->criteria->order = 't.date DESC';

        if (isset($_POST['SaveToExcel']))
            $this->saveToExcel($saleHeaderDataProvider, $startDate, $endDate);

        if (isset($_POST['ExportOutstanding']))
            $this->saveToExcelOutstanding($saleHeaderDataProvider, $startDate, $endDate);

        $this->render('summary', array(
            'saleHeader' => $saleHeader,
            'saleHeaderDataProvider' => $saleHeaderDataProvider,
            'customerCompany' => $customerCompany,
            'startDate' => $startDate,
            'endDate' => $endDate,
        ));
    }
    
    protected function saveToExcel($saleHeaderDataProvider, $startDate, $endDate) {
		set_time_limit(0);
		ini_set('memory_limit', '1024M');
		
        $startDate = (empty($startDate)) ? date('Y-m-d') : $startDate;
        $endDate = (empty($endDate)) ? date('Y-m-d') : $endDate;
//        $startDate = Yii::app()->dateFormatter->format('d MMMM yyyy', $startDate);
//        $endDate = Yii::app()->dateFormatter->format('d MMMM yyyy', $endDate);

        spl_autoload_unregister(array('YiiBase', 'autoload'));
        include_once Yii::getPathOfAlias('ext.phpexcel.Classes') . DIRECTORY_SEPARATOR . 'PHPExcel.php';
        spl_autoload_register(array('YiiBase', 'autoload'));

        $objPHPExcel = new PHPExcel();

        $documentProperties = $objPHPExcel->getProperties();
        $documentProperties->setCreator('PT. Sinar Putra Metalindo');
        $documentProperties->setTitle('Laporan Status Review');

        $worksheet = $objPHPExcel->setActiveSheetIndex(0);
        $worksheet->setTitle('Laporan Status Review');

        $worksheet->mergeCells('A1:Y1');
        $worksheet->mergeCells('A2:Y2');
        $worksheet->mergeCells('A3:Y3');
        $worksheet->getStyle('A1:Y3')->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_CENTER);
        $worksheet->getStyle('A1:Y3')->getFont()->setBold(true);
        $worksheet->setCellValue('A1', 'Sinar Putra Metalindo');
        $worksheet->setCellValue('A2', 'Laporan Status Review');
        $worksheet->setCellValue('A3', Yii::app()->dateFormatter->format('d MMMM yyyy', $startDate) . ' - ' . Yii::app()->dateFormatter->format('d MMMM yyyy', $endDate));

        $worksheet->mergeCells('A4:Y4');
        $worksheet->mergeCells('A5:Y5');

        $worksheet->getStyle("A6:Y6")->getBorders()->getBottom()->setBorderStyle(PHPExcel_Style_Border::BORDER_THICK);
        $worksheet->getStyle("A6:Y6")->getBorders()->getTop()->setBorderStyle(PHPExcel_Style_Border::BORDER_THICK);

        $worksheet->getStyle('A6:Y6')->getFont()->setBold(true);
        $worksheet->setCellValue('A6', 'Tanggal Order');
        $worksheet->setCellValue('B6', 'Customer');
        $worksheet->setCellValue('C6', 'PO #');
        $worksheet->setCellValue('D6', 'Value');
        $worksheet->setCellValue('E6', 'SO #');
        $worksheet->setCellValue('F6', 'Tanggal Est Kirim');
        $worksheet->setCellValue('G6', 'SPK #');
        $worksheet->setCellValue('H6', 'Qty SPK');
        $worksheet->setCellValue('I6', 'Invoice #');
        $worksheet->setCellValue('J6', 'Manual Invoice #');
        $worksheet->setCellValue('K6', 'Tanggal Invoice');
        $worksheet->setCellValue('L6', 'Salesman');
        $worksheet->setCellValue('M6', 'Tanggal TT');
        $worksheet->setCellValue('N6', 'Qty Invoice');
        $worksheet->setCellValue('O6', 'QC Cutting #');
        $worksheet->setCellValue('P6', 'QC Cutting Tanggal');
        $worksheet->setCellValue('Q6', 'Qty QC Cutting');
        $worksheet->setCellValue('R6', 'SJ Cutting #');
        $worksheet->setCellValue('S6', 'SJ Cutting Tanggal');
        $worksheet->setCellValue('T6', 'Qty SJ Cutting');
        $worksheet->setCellValue('U6', 'QC Miling #');
        $worksheet->setCellValue('V6', 'QC Miling Tanggal');
        $worksheet->setCellValue('W6', 'Qty QC Miling');
        $worksheet->setCellValue('X6', 'SJ Miling #');
        $worksheet->setCellValue('Y6', 'SJ Miling Tanggal');
        $worksheet->setCellValue('Z6', 'Qty SJ Miling');

        $counter = 7;

        foreach ($saleHeaderDataProvider->data as $header) {
            if (empty($header->workOrderCuttingHeaders[0]->saleInvoiceHeaders[0])) {
                $worksheet->getStyle("A{$counter}:Z{$counter}")->applyFromArray(array(
                    'fill' => array(
                        'type' => PHPExcel_Style_Fill::FILL_SOLID,
                        'color' => array('rgb' => 'FF0000')
                    )
                ));
            }
                
            $worksheet->setCellValue("A{$counter}", $header->date);
            $worksheet->setCellValue("B{$counter}", CHtml::encode(CHtml::value($header, 'customer.company')));
            $worksheet->setCellValue("C{$counter}", CHtml::encode(CHtml::value($header, 'customer_order_number')));
            $worksheet->setCellValue("D{$counter}", CHtml::encode(CHtml::value($header, 'grandTotalTransaction')));
            $worksheet->setCellValue("E{$counter}", CHtml::encode($header->getCodeNumber(SaleHeader::CN_CONSTANT)));
            $worksheet->setCellValue("F{$counter}", CHtml::encode($header->estimate_delivery_date));
            $workOrderCuttingHeader = empty($header->workOrderCuttingHeaders) ? '' : $header->workOrderCuttingHeaders[0];
            $saleInvoiceHeader = empty($workOrderCuttingHeader->saleInvoiceHeaders) ? '' : $workOrderCuttingHeader->saleInvoiceHeaders[0];
            $saleReceiptDetail = empty($saleInvoiceHeader->saleReceiptDetails) ? '' : $saleInvoiceHeader->saleReceiptDetails[0];
            $worksheet->setCellValue("G{$counter}", CHtml::encode($header->getWorkOrderCuttingHeaderNumber()));
            $worksheet->setCellValue("H{$counter}", empty($header->workOrderCuttingHeaders) ? 0 : CHtml::encode($workOrderCuttingHeader->totalQuantityDetail));
            $worksheet->setCellValue("I{$counter}", CHtml::encode($header->getSaleInvoiceHeaderNumber()));
            $worksheet->setCellValue("J{$counter}", CHtml::encode($header->getManualSaleInvoiceHeaderNumber()));
            $worksheet->setCellValue("K{$counter}", empty($workOrderCuttingHeader->saleInvoiceHeaders) ? '' : CHtml::encode($saleInvoiceHeader->date));
            $worksheet->setCellValue("L{$counter}", CHtml::encode(CHtml::value($header, 'employeeIdSalesman.name')));
            $worksheet->setCellValue("M{$counter}", empty($saleReceiptDetail) ? '' : CHtml::encode($saleReceiptDetail->saleReceiptHeader->date_receipt));
            $worksheet->setCellValue("N{$counter}", empty($workOrderCuttingHeader->saleInvoiceHeaders) ? 0 : CHtml::encode($saleInvoiceHeader->totalQuantity));

            foreach ($header->workOrderCuttingHeaders as $workOrderCuttingHeader) {
                if (!empty($workOrderCuttingHeader->qualityControlCuttingHeaders)) {
                    foreach ($workOrderCuttingHeader->qualityControlCuttingHeaders as $qualityControlCuttingHeader) {
                        $worksheet->setCellValue("O{$counter}", CHtml::encode($qualityControlCuttingHeader->getCodeNumber(QualityControlCuttingHeader::CN_CONSTANT)));
                        $worksheet->setCellValue("P{$counter}", CHtml::encode($qualityControlCuttingHeader->date));
                        $worksheet->setCellValue("Q{$counter}", CHtml::encode(CHtml::value($qualityControlCuttingHeader, 'totalQuantity')));

                        foreach ($qualityControlCuttingHeader->deliveryHeaders as $deliveryHeader) {
                            $worksheet->setCellValue("R{$counter}", CHtml::encode($deliveryHeader->getCodeNumber(DeliveryHeader::CN_CONSTANT)));
                            $worksheet->setCellValue("S{$counter}", CHtml::encode($deliveryHeader->date));
                            $worksheet->setCellValue("T{$counter}", CHtml::encode(CHtml::value($deliveryHeader, 'totalQuantity')));
                        }
                        $counter++;
                    }
                    $counter++;
                }
                
                if (!empty($workOrderCuttingHeader->qualityControlMilingHeaders)) {
                    foreach ($workOrderCuttingHeader->qualityControlMilingHeaders as $qualityControlMilingHeader) {
                        $worksheet->setCellValue("U{$counter}", CHtml::encode($qualityControlMilingHeader->getCodeNumber(QualityControlMilingHeader::CN_CONSTANT)));
                        $worksheet->setCellValue("V{$counter}", CHtml::encode($qualityControlMilingHeader->date));
                        $worksheet->setCellValue("W{$counter}", CHtml::encode(CHtml::value($qualityControlMilingHeader, 'totalQuantity')));

                        foreach ($qualityControlMilingHeader->deliveryHeaders as $deliveryHeader) {
                            $worksheet->setCellValue("X{$counter}", CHtml::encode($deliveryHeader->getCodeNumber(DeliveryHeader::CN_CONSTANT)));
                            $worksheet->setCellValue("Y{$counter}", CHtml::encode($deliveryHeader->date));
                            $worksheet->setCellValue("Z{$counter}", CHtml::encode(CHtml::value($deliveryHeader, 'totalQuantity')));
                        }
                        $counter++;
                    }
                    $counter++;
                }
            }
            $counter++;
        }

        for ($col = 'A'; $col !== 'Y'; $col++) {
            $objPHPExcel->getActiveSheet()
            ->getColumnDimension($col)
            ->setAutoSize(true);
        }

        header('Content-Type: application/xls');
        header('Content-Disposition: attachment;filename="Laporan Status Review.xls"');
        header('Cache-Control: max-age=0');

        $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel5');
        $objWriter->save('php://output');

        Yii::app()->end();
    }
    
    protected function saveToExcelOutstanding($saleHeaderDataProvider, $startDate, $endDate) {
        set_time_limit(0);
        ini_set('memory_limit', '1024M');
		
        $startDate = (empty($startDate)) ? date('Y-m-d') : $startDate;
        $endDate = (empty($endDate)) ? date('Y-m-d') : $endDate;
//        $startDate = Yii::app()->dateFormatter->format('d MMMM yyyy', $startDate);
//        $endDate = Yii::app()->dateFormatter->format('d MMMM yyyy', $endDate);

        spl_autoload_unregister(array('YiiBase', 'autoload'));
        include_once Yii::getPathOfAlias('ext.phpexcel.Classes') . DIRECTORY_SEPARATOR . 'PHPExcel.php';
        spl_autoload_register(array('YiiBase', 'autoload'));

        $objPHPExcel = new PHPExcel();

        $documentProperties = $objPHPExcel->getProperties();
        $documentProperties->setCreator('PT. Sinar Putra Metalindo');
        $documentProperties->setTitle('Laporan Status Review');

        $worksheet = $objPHPExcel->setActiveSheetIndex(0);
        $worksheet->setTitle('Laporan Status Review');

        $worksheet->mergeCells('A1:Y1');
        $worksheet->mergeCells('A2:Y2');
        $worksheet->mergeCells('A3:Y3');
        $worksheet->getStyle('A1:Y3')->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_CENTER);
        $worksheet->getStyle('A1:Y3')->getFont()->setBold(true);
        $worksheet->setCellValue('A1', 'Sinar Putra Metalindo');
        $worksheet->setCellValue('A2', 'Laporan Status Review');
        $worksheet->setCellValue('A3', Yii::app()->dateFormatter->format('d MMMM yyyy', $startDate) . ' - ' . Yii::app()->dateFormatter->format('d MMMM yyyy', $endDate));

        $worksheet->mergeCells('A4:Y4');
        $worksheet->mergeCells('A5:Y5');

        $worksheet->getStyle("A6:Y6")->getBorders()->getBottom()->setBorderStyle(PHPExcel_Style_Border::BORDER_THICK);
        $worksheet->getStyle("A6:Y6")->getBorders()->getTop()->setBorderStyle(PHPExcel_Style_Border::BORDER_THICK);

        $worksheet->getStyle('A6:Y6')->getFont()->setBold(true);
        $worksheet->setCellValue('A6', 'Tanggal Order');
        $worksheet->setCellValue('B6', 'Customer');
        $worksheet->setCellValue('C6', 'PO #');
        $worksheet->setCellValue('D6', 'Value');
        $worksheet->setCellValue('E6', 'SO #');
        $worksheet->setCellValue('F6', 'Tanggal Est Kirim');
        $worksheet->setCellValue('G6', 'SPK #');
        $worksheet->setCellValue('H6', 'Qty SPK');
        $worksheet->setCellValue('I6', 'Invoice #');
        $worksheet->setCellValue('J6', 'Tanggal Invoice');
        $worksheet->setCellValue('K6', 'Salesman');
        $worksheet->setCellValue('L6', 'Tanggal TT');
        $worksheet->setCellValue('M6', 'Qty Invoice');
        $worksheet->setCellValue('N6', 'QC Cutting #');
        $worksheet->setCellValue('O6', 'QC Cutting Tanggal');
        $worksheet->setCellValue('P6', 'Qty QC Cutting');
        $worksheet->setCellValue('Q6', 'SJ Cutting #');
        $worksheet->setCellValue('R6', 'SJ Cutting Tanggal');
        $worksheet->setCellValue('S6', 'Qty SJ Cutting');
        $worksheet->setCellValue('T6', 'QC Miling #');
        $worksheet->setCellValue('U6', 'QC Miling Tanggal');
        $worksheet->setCellValue('V6', 'Qty QC Miling');
        $worksheet->setCellValue('W6', 'SJ Miling #');
        $worksheet->setCellValue('X6', 'SJ Miling Tanggal');
        $worksheet->setCellValue('Y6', 'Qty SJ Miling');

        $counter = 7;

        foreach ($saleHeaderDataProvider->data as $header) {
            if (empty($header->workOrderCuttingHeaders[0]->saleInvoiceHeaders[0])) {
                $worksheet->setCellValue("A{$counter}", $header->date);
                $worksheet->setCellValue("B{$counter}", CHtml::encode(CHtml::value($header, 'customer.company')));
                $worksheet->setCellValue("C{$counter}", CHtml::encode(CHtml::value($header, 'customer_order_number')));
                $worksheet->setCellValue("D{$counter}", CHtml::encode(CHtml::value($header, 'grandTotalTransaction')));
                $worksheet->setCellValue("E{$counter}", CHtml::encode($header->getCodeNumber(SaleHeader::CN_CONSTANT)));
                $worksheet->setCellValue("F{$counter}", CHtml::encode($header->estimate_delivery_date));
                $workOrderCuttingHeader = empty($header->workOrderCuttingHeaders) ? '' : $header->workOrderCuttingHeaders[0];
                $saleInvoiceHeader = empty($workOrderCuttingHeader->saleInvoiceHeaders) ? '' : $workOrderCuttingHeader->saleInvoiceHeaders[0];
                $saleReceiptDetail = empty($saleInvoiceHeader->saleReceiptDetails) ? '' : $saleInvoiceHeader->saleReceiptDetails[0];
                $worksheet->setCellValue("G{$counter}", CHtml::encode($header->getWorkOrderCuttingHeaderNumber()));
                $worksheet->setCellValue("H{$counter}", empty($workOrderCuttingHeader) ? 0 : CHtml::encode($workOrderCuttingHeader->totalQuantityDetail));
                $worksheet->setCellValue("I{$counter}", CHtml::encode($header->getSaleInvoiceHeaderNumber()));
                $worksheet->setCellValue("J{$counter}", empty($saleInvoiceHeader) ? '' : CHtml::encode($saleInvoiceHeader->date));
                $worksheet->setCellValue("K{$counter}", CHtml::encode(CHtml::value($header, 'employeeIdSalesman.name')));
                $worksheet->setCellValue("L{$counter}", empty($saleReceiptDetail) ? '' : CHtml::encode($saleReceiptDetail->saleReceiptHeader->date_receipt));
                $worksheet->setCellValue("M{$counter}", empty($saleInvoiceHeader) ? 0 : CHtml::encode($saleInvoiceHeader->totalQuantity));

                foreach ($header->workOrderCuttingHeaders as $workOrderCuttingHeader) {
                    if (!empty($workOrderCuttingHeader->qualityControlCuttingHeaders)) {
                        foreach ($workOrderCuttingHeader->qualityControlCuttingHeaders as $qualityControlCuttingHeader) {
                            $worksheet->setCellValue("N{$counter}", CHtml::encode($qualityControlCuttingHeader->getCodeNumber(QualityControlCuttingHeader::CN_CONSTANT)));
                            $worksheet->setCellValue("O{$counter}", CHtml::encode($qualityControlCuttingHeader->date));
                            $worksheet->setCellValue("P{$counter}", CHtml::encode(CHtml::value($qualityControlCuttingHeader, 'totalQuantity')));

                            foreach ($qualityControlCuttingHeader->deliveryHeaders as $deliveryHeader) {
                                $worksheet->setCellValue("Q{$counter}", CHtml::encode($deliveryHeader->getCodeNumber(DeliveryHeader::CN_CONSTANT)));
                                $worksheet->setCellValue("R{$counter}", CHtml::encode($deliveryHeader->date));
                                $worksheet->setCellValue("S{$counter}", CHtml::encode(CHtml::value($deliveryHeader, 'totalQuantity')));
                            }
                            $counter++;
                        }
                        $counter++;
                    }

                    if (!empty($workOrderCuttingHeader->qualityControlMilingHeaders)) {
                        foreach ($workOrderCuttingHeader->qualityControlMilingHeaders as $qualityControlMilingHeader) {
                            $worksheet->setCellValue("T{$counter}", CHtml::encode($qualityControlMilingHeader->getCodeNumber(QualityControlMilingHeader::CN_CONSTANT)));
                            $worksheet->setCellValue("U{$counter}", CHtml::encode($qualityControlMilingHeader->date));
                            $worksheet->setCellValue("V{$counter}", CHtml::encode(CHtml::value($qualityControlMilingHeader, 'totalQuantity')));

                            foreach ($qualityControlMilingHeader->deliveryHeaders as $deliveryHeader) {
                                $worksheet->setCellValue("W{$counter}", CHtml::encode($deliveryHeader->getCodeNumber(DeliveryHeader::CN_CONSTANT)));
                                $worksheet->setCellValue("X{$counter}", CHtml::encode($deliveryHeader->date));
                                $worksheet->setCellValue("Y{$counter}", CHtml::encode(CHtml::value($deliveryHeader, 'totalQuantity')));
                            }
                            $counter++;
                        }
                        $counter++;
                    }
                }
                $counter++;
            }
        }

        for ($col = 'A'; $col !== 'Y'; $col++) {
            $objPHPExcel->getActiveSheet()
            ->getColumnDimension($col)
            ->setAutoSize(true);
        }

        header('Content-Type: application/xls');
        header('Content-Disposition: attachment;filename="Laporan Status Review.xls"');
        header('Cache-Control: max-age=0');

        $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel5');
        $objWriter->save('php://output');

        Yii::app()->end();
    }
}