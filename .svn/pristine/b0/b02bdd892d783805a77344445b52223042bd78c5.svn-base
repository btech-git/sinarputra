<?php

class MaterialInvoiceController extends Controller {

    public function filters() {
        return array(
            'access',
        );
    }
    
    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'create') {
            if (!(Yii::app()->user->checkAccess('saleInvoiceCreate')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'delete' || $filterChain->action->id === 'update') {
            if (!(Yii::app()->user->checkAccess('saleInvoiceEdit')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'admin'
                || $filterChain->action->id === 'memo'
                || $filterChain->action->id === 'view') {
            if (!(Yii::app()->user->checkAccess('saleInvoiceCreate') || Yii::app()->user->checkAccess('saleInvoiceEdit')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }


    public function actionCreate() {
        $materialInvoice = $this->instantiate(null);
        $materialInvoice->header->date = date('Y-m-d');
        $materialInvoice->header->datetime_created = date('Y-m-d H:i:s');
//        $materialInvoice->header->cn_month = date('m');
//        $materialInvoice->header->cn_year = date('Y');
        $materialInvoice->header->admin_id = Yii::app()->user->id;
	$materialInvoice->header->is_tax = 1;
	$materialInvoice->header->tax_percentage = 11;

        $customer = Search::bind(new Customer('search'), isset($_GET['Customer']) ? $_GET['Customer'] : array());
        $customerDataProvider = $customer->search();
        $customerDataProvider->criteria->compare('t.is_inactive', 0);

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($materialInvoice);
            $materialInvoice->generateCodeNumber(Yii::app()->dateFormatter->format('M', strtotime($materialInvoice->header->date)), Yii::app()->dateFormatter->format('yy', strtotime($materialInvoice->header->date)));
            
            if ($materialInvoice->save(Yii::app()->db)) {
                $this->redirect(array('view', 'id' => $materialInvoice->header->id));
            }
        }

        $this->render('create', array(
            'materialInvoice' => $materialInvoice,
            'customer' => $customer,
            'customerDataProvider' => $customerDataProvider,
        ));
    }

    public function actionUpdate($id) {
        $materialInvoice = $this->instantiate($id);

        $customer = Search::bind(new Customer('search'), isset($_GET['Customer']) ? $_GET['Customer'] : array());
        $customerDataProvider = $customer->search();
        $customerDataProvider->criteria->compare('t.is_inactive', 0);


        if (isset($_POST['Submit'])) {
            $this->loadState($materialInvoice);
            
            if ($materialInvoice->save(Yii::app()->db)) {
                $this->redirect(array('view', 'id' => $materialInvoice->header->id));
            }
        }

        $this->render('update', array(
            'materialInvoice' => $materialInvoice,
            'customer' => $customer,
            'customerDataProvider' => $customerDataProvider,
        ));
    }

    public function actionView($id) {
        $materialInvoice = $this->loadModel($id);

        $criteria = new CDbCriteria;
        $criteria->compare('t.material_invoice_header_id', $materialInvoice->id);
        $detailsDataProvider = new CActiveDataProvider('MaterialInvoiceDetail', array(
            'criteria' => $criteria,
        ));

        $this->render('view', array(
            'materialInvoice' => $materialInvoice,
            'detailsDataProvider' => $detailsDataProvider,
        ));
    }

    public function actionMemo($id) {
        $materialInvoice = $this->loadModel($id);

        $this->render('memo', array(
            'materialInvoice' => $materialInvoice,
        ));
    }

    public function actionAdmin() {
        $materialInvoice = Search::bind(new MaterialInvoiceHeader('search'), isset($_GET['MaterialInvoiceHeader']) ? $_GET['MaterialInvoiceHeader'] : array());
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';

        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }
        
        $dataProvider = $materialInvoice->search();
        $dataProvider->criteria->with = array(
            'customer:resetScope',
            'employeeIdSalesman:resetScope',
        );
        
        $dataProvider->criteria->addCondition('t.is_inactive = 0');
        $dataProvider->criteria->order = 't.id DESC';

        if (!empty($customerCompany)) {
            $dataProvider->criteria->addCondition('customer.company LIKE :customer_company');
            $dataProvider->criteria->params[':customer_company'] = "%{$customerCompany}%";
        }
        
        $this->render('admin', array(
            'materialInvoice' => $materialInvoice,
            'customerCompany' => $customerCompany,
            'dataProvider' => $dataProvider,
        ));
    }

    public function actionDelete($id) {
        if (Yii::app()->request->isPostRequest) {
            $purchase = $this->loadModel($id);
            if ($purchase !== null) {
                $purchase->is_inactive = ActiveRecord::INACTIVE;
                $purchase->update(array('is_inactive'));
                
                foreach ($purchase->materialInvoiceDetails as $detail) {
                    $detail->is_inactive = ActiveRecord::INACTIVE;
                    $detail->update(array('is_inactive'));
                }
            }

            if (!isset($_GET['ajax']))
                $this->redirect(isset($_POST['returnUrl']) ? $_POST['returnUrl'] : array('admin'));
        }
        else
            throw new CHttpException(400, 'Invalid request. Please do not repeat this request again.');
    }

    public function actionAjaxJsonCustomer($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $customerId = (isset($_POST['MaterialInvoiceHeader']['customer_id'])) ? $_POST['MaterialInvoiceHeader']['customer_id'] : '';
            $customer = Customer::model()->findByPk($customerId);

            $object = array(
                'customer_id' => CHtml::value($customer, 'id'),
                'customer_name' => CHtml::value($customer, 'name'),
                'customer_company' => CHtml::value($customer, 'company'),
                'customer_tax_number' => CHtml::value($customer, 'tax_registration_number'),
                'customer_salesman' => CHtml::value($customer, 'employee.name'),
                'salesman' => CHtml::value($customer, 'employee_id'),
            );
            echo CJSON::encode($object);
        }
    }

    public function actionAjaxJsonTotal($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialInvoice = $this->instantiate($id);
            $this->loadState($materialInvoice);

            $object = array(
                'total' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($materialInvoice->details[$index], 'total'))),
                'subTotal' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $materialInvoice->subTotal)),
                'calculatedTax' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $materialInvoice->calculatedTax)),
                'calculatedTaxIncome' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $materialInvoice->calculatedTaxIncome)),
                'grandTotal' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $materialInvoice->grandTotal)),
            );

            echo CJSON::encode($object);
        }
    }

    public function actionAjaxJsonGrandTotal($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialInvoice = $this->instantiate($id);
            $this->loadState($materialInvoice);

            $object = array(
                'taxValue' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $materialInvoice->getCalculatedTax())),
                'taxIncomeValue' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $materialInvoice->getCalculatedTaxIncome())),
                'grandTotal' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $materialInvoice->getGrandTotal())),
            );

            echo CJSON::encode($object);
        }
    }

    public function actionAjaxHtmlAddMaterial($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialInvoice = $this->instantiate($id);
            $this->loadState($materialInvoice);

            $materialInvoice->details[] = new MaterialInvoiceDetail();

            $this->renderPartial('_detail', array(
                'materialInvoice' => $materialInvoice,
            ));
        }
    }

    public function actionAjaxHtmlRemoveItem($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialInvoice = $this->instantiate($id);

            $this->loadState($materialInvoice);

            $materialInvoice->removeDetailAt($index);

            $this->renderPartial('_detail', array(
                'materialInvoice' => $materialInvoice,
            ));
        }
    }

    public function actionAjaxHtmlUpdateProducts($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchase = $this->instantiate($id);

            $this->loadState($purchase);

            $this->renderPartial('_detail', array(
                'purchase' => $purchase,
            ));
        }
    }

    public function instantiate($id) {
        if (empty($id))
            $materialInvoice = new MaterialInvoice(new MaterialInvoiceHeader(), array());
        else {
            $materialInvoiceHeader = $this->loadModel($id);
            $materialInvoice = new MaterialInvoice($materialInvoiceHeader, $materialInvoiceHeader->materialInvoiceDetails);
        }

        return $materialInvoice;
    }

    public function loadModel($id) {
        $model = MaterialInvoiceHeader::model()->findByPk($id);
        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        return $model;
    }

    public function loadState($materialInvoice) {
        if (isset($_POST['MaterialInvoiceHeader'])) {
            $materialInvoice->header->attributes = $_POST['MaterialInvoiceHeader'];
        }

        if (isset($_POST['MaterialInvoiceDetail'])) {
            foreach ($_POST['MaterialInvoiceDetail'] as $i => $material) {
                if (isset($materialInvoice->details[$i]))
                    $materialInvoice->details[$i]->attributes = $material;
                else {
                    $detail = new MaterialInvoiceDetail();
                    $detail->attributes = $material;
                    $materialInvoice->details[] = $detail;
                }
            }
            if (count($_POST['MaterialInvoiceDetail']) < count($materialInvoice->details))
                array_splice($materialInvoice->details, $i + 1);
        }
        else
            $materialInvoice->details = array();
    }

}
