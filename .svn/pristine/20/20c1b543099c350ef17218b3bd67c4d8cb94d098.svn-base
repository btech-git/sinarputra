<?php

/**
 * @property integer $id
 * @property string $product_name
 * @property string $length
 * @property string $width
 * @property string $height
 * @property string $weight
 * @property string $weight_packing
 * @property string $serial_number
 * @property string $memo
 * @property integer $product_category_id
 * @property integer $receive_header_id
 * @property integer $purchase_detail_id
 * @property integer $location_id
 * @property integer $is_inactive
 *
 * @property PurchaseReturnDetail[] $purchaseReturnDetails
 * @property ProductCategory $productCategory
 * @property ReceiveHeader $receiveHeader
 * @property PurchaseDetail $purchaseDetail
 * @property Location $location
 * @property WorkOrderCuttingDetailMaterial[] $workOrderCuttingDetailMaterials
 */
class ReceiveDetailBase extends ActiveRecord
{
	public function tableName()
	{
		return 'tblsp_receive_detail';
	}

	public function rules()
	{
		return array(
			array('product_name, product_category_id, receive_header_id, location_id', 'required'),
			array('product_category_id, receive_header_id, purchase_detail_id, location_id, is_inactive', 'numerical', 'integerOnly'=>true),
			array('product_name, serial_number', 'length', 'max'=>60),
			array('length, width, height, weight, weight_packing', 'length', 'max'=>10),
			array('memo', 'length', 'max'=>100),
			// The following rule is used by search().
			array('id, product_name, length, width, height, weight, weight_packing, serial_number, memo, product_category_id, receive_header_id, purchase_detail_id, location_id, is_inactive', 'safe', 'on'=>'search'),
		);
	}

	public function relations()
	{
		return array(
			'purchaseReturnDetails' => array(self::HAS_MANY, 'PurchaseReturnDetail', 'receive_detail_id'),
			'productCategory' => array(self::BELONGS_TO, 'ProductCategory', 'product_category_id'),
			'receiveHeader' => array(self::BELONGS_TO, 'ReceiveHeader', 'receive_header_id'),
			'purchaseDetail' => array(self::BELONGS_TO, 'PurchaseDetail', 'purchase_detail_id'),
			'location' => array(self::BELONGS_TO, 'Location', 'location_id'),
			'workOrderCuttingDetailMaterials' => array(self::HAS_MANY, 'WorkOrderCuttingDetailMaterial', 'receive_detail_id'),
		);
	}

	public function attributeLabels()
	{
		return array(
			'id' => 'ID',
			'product_name' => 'Product Name',
			'length' => 'Length',
			'width' => 'Width',
			'height' => 'Height',
			'weight' => 'Weight',
			'weight_packing' => 'Weight Packing',
			'serial_number' => 'Serial Number',
			'memo' => 'Memo',
			'product_category_id' => 'Product Category',
			'receive_header_id' => 'Receive Header',
			'purchase_detail_id' => 'Purchase Detail',
			'location_id' => 'Location',
			'is_inactive' => 'Is Inactive',
		);
	}

	public function search()
	{
		$criteria = new CDbCriteria;

		$criteria->compare('t.id', $this->id);
		$criteria->compare('t.product_name', $this->product_name, true);
		$criteria->compare('t.length', $this->length, true);
		$criteria->compare('t.width', $this->width, true);
		$criteria->compare('t.height', $this->height, true);
		$criteria->compare('t.weight', $this->weight, true);
		$criteria->compare('t.weight_packing', $this->weight_packing, true);
		$criteria->compare('t.serial_number', $this->serial_number, true);
		$criteria->compare('t.memo', $this->memo, true);
		$criteria->compare('t.product_category_id', $this->product_category_id);
		$criteria->compare('t.receive_header_id', $this->receive_header_id);
		$criteria->compare('t.purchase_detail_id', $this->purchase_detail_id);
		$criteria->compare('t.location_id', $this->location_id);
		$criteria->compare('t.is_inactive', $this->is_inactive);

		return new CActiveDataProvider($this, array(
			'criteria'=>$criteria,
		));
	}
}
