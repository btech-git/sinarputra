<?php

class QualityControlMilingController extends Controller {

    public function filters() {
        return array(
            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'create') {
            if (!(Yii::app()->user->checkAccess('qcMilingCreate')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'delete' || $filterChain->action->id === 'update') {
            if (!(Yii::app()->user->checkAccess('qcMilingEdit')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'view'
                || $filterChain->action->id === 'memo'
                || $filterChain->action->id === 'admin') {
            if (!(Yii::app()->user->checkAccess('qcMilingCreate') || Yii::app()->user->checkAccess('qcMilingEdit')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }

    public function actionProductionMilingList() {
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';
        $customerPurchaseNumber = isset($_GET['CustomerPurchaseNumber']) ? $_GET['CustomerPurchaseNumber'] : '';
        $workOrderOrdinal = isset($_GET['WorkOrderOrdinal']) ? $_GET['WorkOrderOrdinal'] : '';
        $workOrderMonth = isset($_GET['WorkOrderMonth']) ? $_GET['WorkOrderMonth'] : '';
        $workOrderYear = isset($_GET['WorkOrderYear']) ? $_GET['WorkOrderYear'] : '';

        $productionMilingHeader = Search::bind(new ProductionMilingHeader('search'), isset($_GET['ProductionMilingHeader']) ? $_GET['ProductionMilingHeader'] : '');
        $productionMilingHeaderDataProvider = $productionMilingHeader->searchForQualityControl();
        $productionMilingHeaderDataProvider->criteria->with = array(
            'productionPlanningMilingHeader' => array(
                'with' => array(
                    'workOrderCuttingHeader' => array(
                        'with' => array(
                            'saleHeader' => array(
                                'with' => array(
                                    'customer:resetScope'
                                )
                            )
                        )
                    )
                )
            )
        );

        if (!empty($workOrderOrdinal)) {
            $productionMilingHeaderDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_ordinal = :cn_ordinal');
            $productionMilingHeaderDataProvider->criteria->params[':cn_ordinal'] = $workOrderOrdinal;
        }
        
        if (!empty($workOrderMonth)) {
            $productionMilingHeaderDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_month = :cn_month');
            $productionMilingHeaderDataProvider->criteria->params[':cn_month'] = $workOrderMonth;
        }
        
        if (!empty($workOrderYear)) {
            $productionMilingHeaderDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_year = :cn_year');
            $productionMilingHeaderDataProvider->criteria->params[':cn_year'] = $workOrderYear;
        }
        
        if (!empty($customerCompany)) {
            $productionMilingHeaderDataProvider->criteria->addCondition('customer.company LIKE :customer_company');
            $productionMilingHeaderDataProvider->criteria->params[':customer_company'] = "%{$customerCompany}%";
        }

        $productionMilingHeaderDataProvider->criteria->addCondition("saleHeader.customer_order_number LIKE :customer_order_number");
        $productionMilingHeaderDataProvider->criteria->params[':customer_order_number'] = "%{$customerPurchaseNumber}%";

        $this->render('productionMilingList', array(
            'productionMilingHeader' => $productionMilingHeader,
            'productionMilingHeaderDataProvider' => $productionMilingHeaderDataProvider,
            'customerCompany' => $customerCompany,
            'customerPurchaseNumber' => $customerPurchaseNumber,
            'workOrderOrdinal' => $workOrderOrdinal,
            'workOrderMonth' => $workOrderMonth,
            'workOrderYear' => $workOrderYear,
        ));
    }

    public function actionCreate($productionMilingId) {
        $qualityControl = $this->instantiate(null);
        $productionMilingHeader = ProductionMilingHeader::model()->findByPk($productionMilingId);
        $qualityControl->header->admin_id = Yii::app()->user->id;
        $qualityControl->generateCodeNumber(date('m'), date('y'));
        $qualityControl->header->date = date('Y-m-d');
        $qualityControl->header->production_miling_header_id = $productionMilingId;
        $qualityControl->header->work_order_cutting_header_id = $productionMilingHeader->productionPlanningMilingHeader->work_order_cutting_header_id;
        $qualityControl->addDetails($productionMilingId);

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($qualityControl);
            
            if ($qualityControl->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $qualityControl->header->id));
        }

        $this->render('create', array(
            'qualityControl' => $qualityControl,
        ));
    }

    public function actionView($id) {
        $qualityControl = $this->loadModel($id);

        $criteria = new CDbCriteria;
        $criteria->compare('quality_control_miling_header_id', $qualityControl->id);

        $detailsDataProvider = new CActiveDataProvider('QualityControlMilingDetail', array(
            'criteria' => $criteria,
        ));

        $this->render('view', array(
            'qualityControl' => $qualityControl,
            'detailsDataProvider' => $detailsDataProvider,
        ));
    }

    public function actionUpdate($id) {
        $qualityControl = $this->instantiate($id);

        if (isset($_POST['Submit'])) {
            $this->loadState($qualityControl);

            if ($qualityControl->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $qualityControl->header->id));
        }

        $this->render('update', array(
            'qualityControl' => $qualityControl,
        ));
    }

    public function actionAdmin() {
        $qualityControlMiling = Search::bind(new QualityControlMilingHeader('search'), isset($_GET['QualityControlMilingHeader']) ? $_GET['QualityControlMilingHeader'] : array());
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';
        $customerPurchaseNumber = isset($_GET['CustomerPurchaseNumber']) ? $_GET['CustomerPurchaseNumber'] : '';
        $workOrderOrdinal = isset($_GET['WorkOrderOrdinal']) ? $_GET['WorkOrderOrdinal'] : '';
        $workOrderMonth = isset($_GET['WorkOrderMonth']) ? $_GET['WorkOrderMonth'] : '';
        $workOrderYear = isset($_GET['WorkOrderYear']) ? $_GET['WorkOrderYear'] : '';

        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }

        $qualityControlDataProvider = $qualityControlMiling->search();
        $qualityControlDataProvider->criteria->with = array(
            'productionMilingHeader' => array(
                'with' => array(
                    'productionPlanningMilingHeader'
                ),
            ),
            'workOrderCuttingHeader' => array(
                'with' => array(
                    'saleHeader' => array(
                        'with' => array(
                            'customer',
                        ),
                    ),
                ),
            ),
        );
        
        if (!empty($customerCompany)) {
            $qualityControlDataProvider->criteria->addCondition("customer.company LIKE :company");
            $qualityControlDataProvider->criteria->params[':company'] = "%{$customerCompany}%";
        }
        
        if (!empty($workOrderOrdinal)) {
            $qualityControlDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_ordinal = :cn_ordinal');
            $qualityControlDataProvider->criteria->params[':cn_ordinal'] = $workOrderOrdinal;
        }
        
        if (!empty($workOrderMonth)) {
            $qualityControlDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_month = :cn_month');
            $qualityControlDataProvider->criteria->params[':cn_month'] = $workOrderMonth;
        }
        
        if (!empty($workOrderYear)) {
            $qualityControlDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_year = :cn_year');
            $qualityControlDataProvider->criteria->params[':cn_year'] = $workOrderYear;
        }
        
        $qualityControlDataProvider->criteria->addCondition('t.is_inactive = 0');
        $qualityControlDataProvider->criteria->order = 't.id DESC';

        $this->render('admin', array(
            'qualityControlMiling' => $qualityControlMiling,
            'qualityControlDataProvider' => $qualityControlDataProvider,
            'customerCompany' => $customerCompany,
            'customerPurchaseNumber' => $customerPurchaseNumber,
            'workOrderOrdinal' => $workOrderOrdinal,
            'workOrderMonth' => $workOrderMonth,
            'workOrderYear' => $workOrderYear,
        ));
    }

    public function actionLabel($detailId) {
        $qualityControlMilingDetail = QualityControlMilingDetail::model()->findByPk($detailId);
        
        $this->render('label', array(
            'qualityControlMilingDetail' => $qualityControlMilingDetail,
        ));
    }

    public function actionAjaxHtmlAddWorkOrder($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $qualityControl = $this->instantiate($id);

            $this->loadState($qualityControl);

            if (isset($_POST['selectedIds'])) {
                $ids = array();
                $ids = $_POST['selectedIds'];

                foreach ($ids as $id) {
                    $qualityControl->addDetail($id);
                }
            }
            else if (isset($_POST['WorkOrderId']))
                $qualityControl->addDetail($_POST['WorkOrderId']);

            $this->renderPartial('_detail', array(
                'qualityControl' => $qualityControl,
            ), false, true);
        }
    }

    public function actionAjaxHtmlRemoveWorkOrder($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $qualityControl = $this->instantiate($id);

            $this->loadState($qualityControl);

            $qualityControl->removeDetailAt($index);

            $this->renderPartial('_detail', array(
                'qualityControl' => $qualityControl,
            ));
        }
    }

    public function instantiate($id) {
        if (empty($id))
            $qualityControl = new QualityControlMiling(new QualityControlMilingHeader(), array());
        else {
            $header = $this->loadModel($id);
            $qualityControl = new QualityControlMiling($header, $header->qualityControlMilingDetails);
        }

        return $qualityControl;
    }

    public function loadModel($id) {
        $qualityControl = QualityControlMilingHeader::model()->findByPk($id);
        
        if ($qualityControl === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        
        return $qualityControl;
    }

    public function loadState($qualityControl) {
        if (isset($_POST['QualityControlMilingHeader']))
            $qualityControl->header->attributes = $_POST['QualityControlMilingHeader'];

        if (isset($_POST['QualityControlMilingDetail'])) {
            foreach ($_POST['QualityControlMilingDetail'] as $i => $item) {
                if (isset($qualityControl->details[$i]))
                    $qualityControl->details[$i]->attributes = $item;
                else {
                    $detail = new QualityControlMilingDetail();
                    $detail->attributes = $item;
                    $qualityControl->details[] = $detail;
                }
            }
            if (count($_POST['QualityControlMilingDetail']) < count($qualityControl->details))
                array_splice($qualityControl->details, $i + 1);
        }
        else
            $qualityControl->details = array();
    }

}