    public function actionAjaxHtmlAddExternalOrders($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchase = $this->instantiate($id);
            $this->loadState($purchase);

            if (isset($_POST['selectedIds'])) {
                $externalOrders = array();
                $externalOrders = $_POST['selectedIds'];

                foreach ($externalOrders as $id) {
                    $purchase->addExternalOrder($id);
                }
            }

            $this->renderPartial('_detail', array(
                'purchase' => $purchase,
            ));
        }
    }

    public function actionAjaxHtmlRemoveExternalOrder($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchase = $this->instantiate($id);
            $this->loadState($purchase);

            $purchase->removeExternalOrderAt($index);

            $this->renderPartial('_detail', array(
                'purchase' => $purchase,
            ));
        }
    }

