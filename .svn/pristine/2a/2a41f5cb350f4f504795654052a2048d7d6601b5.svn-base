<?php

class ProductionCuttingHeader extends ProductionCuttingHeaderBase {

    const CN_CONSTANT = 'PRDC';

    public static function model($className = __CLASS__) {
        return parent::model($className);
    }

    public function searchWithPaging() {
        $criteria = new CDbCriteria;

        $criteria->compare('t.id', $this->id);
        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.production_planning_cutting_header_id', $this->production_planning_cutting_header_id);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.is_inactive', $this->is_inactive);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
            'pagination' => array(
                'pageSize' => Yii::app()->user->getState('pageSize', Yii::app()->params['defaultPageSize']),
            ),
            'sort' => array(
                'defaultOrder' => 't.id DESC',
            ),
        ));
    }

    public function searchForQualityControl() {
        $criteria = new CDbCriteria;

        $criteria->condition = "EXISTS (
            SELECT wo.quantity - COALESCE(SUM(qc.quantity), 0) AS quantity_remaining, 
            wo.id AS production_cutting_detail_id
            FROM " . ProductionCuttingDetail::model()->tableName() . " wo
            LEFT OUTER JOIN " . QualityControlCuttingDetail::model()->tableName() . " qc
            ON wo.id = qc.production_cutting_detail_id
            WHERE t.id = wo.production_cutting_header_id AND t.is_inactive = 0
            GROUP BY wo.id
            HAVING quantity_remaining > 0
        )
        AND t.is_inactive = 0 AND t.date > '2021-12-31'";

        $criteria->compare('t.id', $this->id);
        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.production_planning_cutting_header_id', $this->production_planning_cutting_header_id);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.is_inactive', $this->is_inactive);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
        ));
    }
}
