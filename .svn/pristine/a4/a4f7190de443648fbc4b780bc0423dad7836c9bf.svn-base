<?php

class MaterialPaymentController extends Controller {

    public function filters() {
        return array(
//            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'create') {
            if (!(Yii::app()->user->checkAccess('materialPaymentCreate')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'delete' || $filterChain->action->id === 'update') {
            if (!(Yii::app()->user->checkAccess('materialPaymentEdit')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'admin'
                || $filterChain->action->id === 'ajaxHtmlResetPayment' 
                || $filterChain->action->id === 'ajaxHtmlRemovePayment'
                || $filterChain->action->id === 'ajaxHtmlAddAccount' 
                || $filterChain->action->id === 'ajaxJsonTotal'
                || $filterChain->action->id === 'ajaxJsonSaleReceipt' 
                || $filterChain->action->id === 'memo' 
                || $filterChain->action->id === 'view') {
            if (!(Yii::app()->user->checkAccess('materialPaymentCreate') || Yii::app()->user->checkAccess('materialPaymentEdit')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }

    public function actionCreate() {
        $materialPayment = $this->instantiate(null);

        $materialPayment->header->admin_id = Yii::app()->user->id;
        $materialPayment->header->datetime_created = date('Y-m-d H:i:s');
        $materialPayment->header->date_transaction = date('Y-m-d');
        $materialPayment->header->date_payment = date('Y-m-d');

        $materialInvoice = Search::bind(new MaterialInvoiceHeader('search'), isset($_GET['MaterialInvoiceHeader']) ? $_GET['MaterialInvoiceHeader'] : array());
        $materialInvoiceDataProvider = $materialInvoice->searchForMaterialPayment();

        $customer = Search::bind(new Customer('search'), isset($_GET['Customer']) ? $_GET['Customer'] : array());
        $customerDataProvider = $customer->search();

        $customerId = isset($_GET['MaterialPaymentHeader']['customer_id']) ? $_GET['MaterialPaymentHeader']['customer_id'] : '';

        if (!empty($customerId)) {
            $materialInvoiceDataProvider->criteria->addCondition("t.customer_id = :customer_id");
            $materialInvoiceDataProvider->criteria->params[':customer_id'] = $customerId;
        }
        
        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($materialPayment);
            $materialPayment->generateCodeNumber(Yii::app()->dateFormatter->format('M', strtotime($materialPayment->header->date_transaction)), Yii::app()->dateFormatter->format('yy', strtotime($materialPayment->header->date_transaction)));

            if ($materialPayment->save(Yii::app()->db)) {
                $this->redirect(array('view', 'id' => $materialPayment->header->id));
            }
        }

        $this->render('create', array(
            'materialPayment' => $materialPayment,
            'materialInvoice' => $materialInvoice,
            'materialInvoiceDataProvider' => $materialInvoiceDataProvider,
            'customer' => $customer,
            'customerDataProvider' => $customerDataProvider,
        ));
    }

    public function actionUpdate($id) {
        $materialPayment = $this->instantiate($id);

        $materialInvoice = Search::bind(new MaterialInvoiceHeader('search'), isset($_GET['MaterialInvoiceHeader']) ? $_GET['MaterialInvoiceHeader'] : array());
        $materialInvoiceDataProvider = $materialInvoice->searchForMaterialPayment();

        $customerId = isset($_GET['MaterialPaymentHeader']['customer_id']) ? $_GET['MaterialPaymentHeader']['customer_id'] : '';

        if (!empty($customerId)) {
            $materialInvoiceDataProvider->criteria->addCondition("saleHeader.customer_id = :customer_id");
            $materialInvoiceDataProvider->criteria->params[':customer_id'] = $customerId;
        }
        
        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($materialPayment);

            if ($materialPayment->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $materialPayment->header->id));
        }

        $this->render('update', array(
            'materialPayment' => $materialPayment,
            'materialInvoice' => $materialInvoice,
            'materialInvoiceDataProvider' => $materialInvoiceDataProvider,
        ));
    }

    public function actionView($id) {
        $materialPayment = $this->loadModel($id);

        $criteria = new CDbCriteria;
        $criteria->compare('sale_payment_header_id', $materialPayment->id);
        $detailsDataProvider = new CActiveDataProvider('MaterialPaymentDetail', array(
                    'criteria' => $criteria,
                ));

        $this->render('view', array(
            'materialPayment' => $materialPayment,
            'detailsDataProvider' => $detailsDataProvider,
        ));
    }

    public function actionDelete($id) {
        if (Yii::app()->request->isPostRequest) {
            $materialPayment = $this->instantiate($id);
            if ($materialPayment !== null) {
                foreach ($this->details as $detail) {
                    $materialInvoiceHeader = MaterialInvoiceHeader::model()->findByPk($detail->sale_invoice_header_id);
                    $materialInvoiceHeader->total_payment = 0.00;
                    $valid = $materialInvoiceHeader->update(array('total_payment')) && $valid;
                }
                
                $materialPayment->delete(Yii::app()->db);
                
                Yii::app()->user->setFlash('message', 'Delete Successful');
            }
        }
        else
            throw new CHttpException(400, 'Invalid request. Please do not repeat this request again.');
    }

    public function actionAdmin() {
        $materialPayment = Search::bind(new MaterialPaymentHeader('search'), isset($_GET['MaterialPaymentHeader']) ? $_GET['MaterialPaymentHeader'] : array());
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';

        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }
        
        $dataProvider = $materialPayment->search();
        $dataProvider->criteria->with = array(
            'customer',
        );
        
		$dataProvider->criteria->addCondition("customer.company LIKE :company");
		$dataProvider->criteria->params[':company'] = "%{$customerCompany}%";
        
        $dataProvider->criteria->addCondition('t.is_inactive = 0');
        $dataProvider->criteria->order = 't.id DESC';

        $this->render('admin', array(
            'materialPayment' => $materialPayment,
            'dataProvider' => $dataProvider,
            'customerCompany' => $customerCompany,
        ));
    }

    public function actionAjaxJsonCustomer($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $customerId = (isset($_POST['MaterialPaymentHeader']['customer_id'])) ? $_POST['MaterialPaymentHeader']['customer_id'] : '';

            $customer = Customer::model()->findByPk($customerId);

            $object = array(
                'customer_id' => CHtml::value($customer, 'id'),
                'customer_name' => CHtml::value($customer, 'name'),
                'customer_company' => CHtml::value($customer, 'company'),
                'customer_address_main' => CHtml::value($customer, 'address_main'),
                'customer_due_days' => CHtml::value($customer, 'invoice_due_days'),
            );
            echo CJSON::encode($object);
        }
    }

    public function actionAjaxJsonTotal($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialPayment = $this->instantiate($id);

            $this->loadState($materialPayment);

            $object = array(
                'amount' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($materialPayment->details[$index], 'amount'))),
                'totalAdditionalPayment1' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($materialPayment, 'totalAdditionalPayment1'))),
                'totalAdditionalPayment2' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($materialPayment, 'totalAdditionalPayment2'))),
                'payment' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($materialPayment, 'totalPayment'))),
                'receivable' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($materialPayment, 'totalReceivable'))),
                'remaining' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($materialPayment, 'remaining'))),
            );

            echo CJSON::encode($object);
        }
    }

    public function actionAjaxHtmlAddInvoices($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialPayment = $this->instantiate($id);
            $this->loadState($materialPayment);

            if (isset($_POST['selectedIds'])) {
                $invoices = array();
                $invoices = $_POST['selectedIds'];

                foreach ($invoices as $invoice) {
                    $materialPayment->addInvoice($invoice);
                }
            }

            $this->renderPartial('_detail', array(
                'materialPayment' => $materialPayment,
            ));
        }
    }

    public function actionAjaxHtmlRemoveDetail($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialPayment = $this->instantiate($id);
            $this->loadState($materialPayment);

            $materialPayment->removeDetailAt($index);

            $this->renderPartial('_detail', array(
                'materialPayment' => $materialPayment,
            ));
        }
    }

    public function actionAjaxHtmlResetDetail($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialPayment = $this->instantiate($id);
            $this->loadState($materialPayment);

            $materialPayment->resetDetail();

            $this->renderPartial('_detail', array(
                'materialPayment' => $materialPayment,
            ));
        }
    }

    public function instantiate($id) {
        if (empty($id))
            $materialPayment = new MaterialPayment(new MaterialPaymentHeader(), array());
        else {
            $materialPaymentHeader = $this->loadModel($id);
            $materialPayment = new MaterialPayment($materialPaymentHeader, $materialPaymentHeader->materialPaymentDetails);
        }

        return $materialPayment;
    }

    public function loadModel($id) {
        $model = MaterialPaymentHeader::model()->findByPk($id);

        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');

        return $model;
    }

    protected function loadState(&$materialPayment) {
        if (isset($_POST['MaterialPaymentHeader'])) {
            $materialPayment->header->attributes = $_POST['MaterialPaymentHeader'];
        }
        if (isset($_POST['MaterialPaymentDetail'])) {
            foreach ($_POST['MaterialPaymentDetail'] as $i => $item) {
                if (isset($materialPayment->details[$i]))
                    $materialPayment->details[$i]->attributes = $item;
                else {
                    $detail = new MaterialPaymentDetail();
                    $detail->attributes = $item;
                    $materialPayment->details[] = $detail;
                }
            }
            if (count($_POST['MaterialPaymentDetail']) < count($materialPayment->details))
                array_splice($materialPayment->details, $i + 1);
        }
        else
            $materialPayment->details = array();
    }

}
