<?php

class MaterialReceiptController extends Controller {

    public function filters() {
        return array(
//            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'create') {
            if (!(Yii::app()->user->checkAccess('materialReceiptCreate')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'delete' || $filterChain->action->id === 'update') {
            if (!(Yii::app()->user->checkAccess('materialReceiptEdit'))) {
                $this->redirect(array('/site/login'));
            }
        }
        if ($filterChain->action->id === 'admin'
                || $filterChain->action->id === 'ajaxHtmlRemoveDetail' 
                || $filterChain->action->id === 'ajaxHtmlAddSaleInvoice'
                || $filterChain->action->id === 'ajaxJsonCustomer'
                || $filterChain->action->id === 'memo' 
                || $filterChain->action->id === 'view') {
            if (!(Yii::app()->user->checkAccess('materialReceiptCreate') || Yii::app()->user->checkAccess('materialReceiptEdit')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }

    public function actionCreate() {
        $materialReceipt = $this->instantiate(null);
        $materialReceipt->header->date = date('Y-m-d');
        $materialReceipt->header->due_date = date('Y-m-d');
        $materialReceipt->header->admin_id = Yii::app()->user->id;

        $materialInvoice = Search::bind(new MaterialInvoiceHeader('search'), isset($_GET['MaterialInvoiceHeader']) ? $_GET['MaterialInvoiceHeader'] : array());
        $materialInvoiceDataProvider = $materialInvoice->searchForMaterialReceipt();

        $customer = Search::bind(new Customer('search'), isset($_GET['Customer']) ? $_GET['Customer'] : array());
        $customerDataProvider = $customer->search();

        $customerId = isset($_GET['MaterialReceiptHeader']['customer_id']) ? $_GET['MaterialReceiptHeader']['customer_id'] : '';

        $materialInvoiceDataProvider->criteria->with = array(
            'customer'
        );

        if (!empty($customerId)) {
            $materialInvoiceDataProvider->criteria->addCondition("t.customer_id = :customer_id");
            $materialInvoiceDataProvider->criteria->params[':customer_id'] = $customerId;
        }

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($materialReceipt);
            $materialReceipt->generateCodeNumber(Yii::app()->dateFormatter->format('M', strtotime($materialReceipt->header->date)), Yii::app()->dateFormatter->format('yy', strtotime($materialReceipt->header->date)));
            
            if ($materialReceipt->save(Yii::app()->db)) {
                $this->redirect(array('view', 'id' => $materialReceipt->header->id));
            }
        }

        $this->render('create', array(
            'materialReceipt' => $materialReceipt,
            'materialInvoice' => $materialInvoice,
            'materialInvoiceDataProvider' => $materialInvoiceDataProvider,
            'customer' => $customer,
            'customerDataProvider' => $customerDataProvider,
        ));
    }

    public function actionUpdate($id) {
        $materialReceipt = $this->instantiate($id);
        $materialInvoice = Search::bind(new ManualSaleInvoiceHeader('search'), isset($_GET['ManualSaleInvoiceHeader']) ? $_GET['ManualSaleInvoiceHeader'] : array());
        $materialInvoiceDataProvider = $materialInvoice->searchForSaleReceipt();

        $materialInvoiceDataProvider->criteria->with = array('customer');

        if (!empty($materialReceipt->header->customer_id)) {
            $materialInvoiceDataProvider->criteria->addCondition("t.customer_id = :customer_id");
            $materialInvoiceDataProvider->criteria->params[':customer_id'] = $materialReceipt->header->customer_id;
        }

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($materialReceipt);
            
            if ($materialReceipt->save(Yii::app()->db)) {
                $this->redirect(array('view', 'id' => $materialReceipt->header->id));
            }
        }

        $this->render('update', array(
            'materialReceipt' => $materialReceipt,
            'materialInvoice' => $materialInvoice,
            'materialInvoiceDataProvider' => $materialInvoiceDataProvider,
        ));
    }

    public function actionView($id) {
        $materialReceipt = $this->loadModel($id);

        $criteria = new CDbCriteria;
        $criteria->compare('material_receipt_header_id', $materialReceipt->id);
        $detailsDataProvider = new CActiveDataProvider('MaterialReceiptDetail', array(
            'criteria' => $criteria,
        ));

        $this->render('view', array(
            'materialReceipt' => $materialReceipt,
            'detailsDataProvider' => $detailsDataProvider,
        ));
    }

    public function actionMemo($id) {
        $materialReceipt = $this->loadModel($id);

        $this->render('memo', array(
            'materialReceipt' => $materialReceipt
        ));
    }

    public function actionAdmin() {
        $materialReceipt = Search::bind(new MaterialReceiptHeader('search'), isset($_GET['MaterialReceiptHeader']) ? $_GET['MaterialReceiptHeader'] : array());
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';
        
        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }

        $dataProvider = $materialReceipt->search();
        $dataProvider->criteria->with = array('customer:resetScope');

        $dataProvider->criteria->addCondition("customer.company LIKE :company");
        $dataProvider->criteria->params[':company'] = "%{$customerCompany}%";

        $dataProvider->criteria->addCondition('t.is_inactive = 0');
        $dataProvider->criteria->order = 't.id DESC';
        
        $this->render('admin', array(
            'materialReceipt' => $materialReceipt,
            'dataProvider' => $dataProvider,
            'customerCompany' => $customerCompany,
        ));
    }

    public function actionDelete($id) {
        if (Yii::app()->request->isPostRequest) {
            $materialReceiptHeader = $this->instantiate($id);
            if ($materialReceiptHeader !== null) {
                if ($materialReceiptHeader->header->manualSalePaymentHeaders != NULL) {
                    Yii::app()->user->setFlash('message', 'This Transaction Has Been Used as Reference');
                } else {
                    $materialReceiptHeader->delete(Yii::app()->db);
                    Yii::app()->user->setFlash('message', 'Delete Successful');
                }
            }
        }
        else
            throw new CHttpException(400, 'Invalid request. Please do not repeat this request again.');
    }

    public function actionAjaxHtmlAddInvoices($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialReceipt = $this->instantiate($id);
            $this->loadState($materialReceipt);

            if (isset($_POST['selectedIds'])) {
                $invoices = array();
                $invoices = $_POST['selectedIds'];

                foreach ($invoices as $invoice) {
                    $materialReceipt->addInvoice($invoice);
                }
            }

            $this->renderPartial('_detail', array(
                'materialReceipt' => $materialReceipt,
            ));
        }
    }

    public function actionAjaxJsonCustomer($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $customerId = (isset($_POST['MaterialReceiptHeader']['customer_id'])) ? $_POST['MaterialReceiptHeader']['customer_id'] : '';

            $customer = Customer::model()->findByPk($customerId);

            $object = array(
                'customer_id' => CHtml::value($customer, 'id'),
                'customer_name' => CHtml::value($customer, 'name'),
                'customer_company' => CHtml::value($customer, 'company'),
                'customer_address_main' => CHtml::value($customer, 'address_main'),
                'customer_due_days' => CHtml::value($customer, 'invoice_due_days'),
            );
            echo CJSON::encode($object);
        }
    }

    public function actionAjaxHtmlRemoveDetail($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialReceipt = $this->instantiate($id);
            $this->loadState($materialReceipt);

            $materialReceipt->removeDetailAt($index);

            $this->renderPartial('_detail', array(
                'materialReceipt' => $materialReceipt
            ));
        }
    }

    public function actionAjaxHtmlResetDetail($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $materialReceipt = $this->instantiate($id);
            $this->loadState($materialReceipt);

            $materialReceipt->resetDetail();

            $this->renderPartial('_detail', array(
                'materialReceipt' => $materialReceipt
            ));
        }
    }

    public function instantiate($id) {
        if (empty($id))
            $materialReceipt = new MaterialReceipt(new MaterialReceiptHeader(), array());
        else {
            $materialReceiptHeader = $this->loadModel($id);
            $materialReceipt = new MaterialReceipt($materialReceiptHeader, $materialReceiptHeader->materialReceiptDetails);
        }

        return $materialReceipt;
    }

    public function loadModel($id) {
        $model = MaterialReceiptHeader::model()->findByPk($id);
        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        return $model;
    }

    public function loadState($materialReceipt) {
        if (isset($_POST['MaterialReceiptHeader'])) {
            $materialReceipt->header->attributes = $_POST['MaterialReceiptHeader'];
        }
        if (isset($_POST['MaterialReceiptDetail'])) {
            foreach ($_POST['MaterialReceiptDetail'] as $i => $item) {
                if (isset($materialReceipt->details[$i]))
                    $materialReceipt->details[$i]->attributes = $item;
                else {
                    $detail = new MaterialReceiptDetail();
                    $detail->attributes = $item;
                    $materialReceipt->details[] = $detail;
                }
            }
            if (count($_POST['MaterialReceiptDetail']) < count($materialReceipt->details))
                array_splice($materialReceipt->details, $i + 1);
        }
        else
            $materialReceipt->details = array();
    }
}