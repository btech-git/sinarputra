    public function actionMemoDelivery($id) {

//        if (!(Yii::app()->user->checkAccess('administrator'))) {
//            if (!(isset(Yii::app()->session['SaleInvoiceMemoAllowed']) && Yii::app()->session['SaleInvoiceMemoAllowed'] === true))
//                $this->redirect(array('admin'));
//        }
//
//        Yii::app()->session->remove('SaleInvoiceMemoAllowed');

        $saleInvoice = $this->loadModel($id);

        $isTax = 0;

        if ($saleInvoice->workOrderCuttingHeader->saleHeader->saleDetails[0]->quotationDetailProduct !== null)
            $isTax = $saleInvoice->workOrderCuttingHeader->saleHeader->saleDetails[0]->quotationDetailProduct->quotationHeader->is_tax;
        else
            $isTax = $saleInvoice->workOrderCuttingHeader->saleHeader->saleDetails[0]->quotationDetailService->quotationHeader->is_tax;

        $this->render('memoDelivery', array(
            'saleInvoice' => $saleInvoice,
            'isTax' => $isTax
        ));
    }    

    public function actionAdmin() {
        $saleInvoice = Search::bind(new SaleInvoiceHeader('search'), isset($_GET['SaleInvoiceHeader']) ? $_GET['SaleInvoiceHeader'] : array());
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';
        $customerOrderNumber = isset($_GET['CustomerOrderNumber']) ? $_GET['CustomerOrderNumber'] : '';
        $workOrderOrdinal = isset($_GET['WorkOrderOrdinal']) ? $_GET['WorkOrderOrdinal'] : '';
        $workOrderMonth = isset($_GET['WorkOrderMonth']) ? $_GET['WorkOrderMonth'] : '';
        $workOrderYear = isset($_GET['WorkOrderYear']) ? $_GET['WorkOrderYear'] : '';

        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }

        $dataProvider = $saleInvoice->search();
        $dataProvider->criteria->with = array(
            'customer:resetScope',
            'employeeIdSalesman:resetScope',
            'workOrderCuttingHeader' => array(
                'with' => array(
                    'saleHeader'
                ),
            ),
        );
        $dataProvider->criteria->order = 't.id DESC';
//        $dataProvider->criteria->condition = 't.is_inactive = 0';
        
        if (!empty($workOrderOrdinal)) {
            $dataProvider->criteria->addCondition('workOrderCuttingHeader.cn_ordinal = :cn_ordinal');
            $dataProvider->criteria->params[':cn_ordinal'] = $workOrderOrdinal;
        }
        if (!empty($workOrderMonth)) {
            $dataProvider->criteria->addCondition('workOrderCuttingHeader.cn_month = :cn_month');
            $dataProvider->criteria->params[':cn_month'] = $workOrderMonth;
        }
        if (!empty($workOrderYear)) {
            $dataProvider->criteria->addCondition('workOrderCuttingHeader.cn_year = :cn_year');
            $dataProvider->criteria->params[':cn_year'] = $workOrderYear;
        }
        
        if (!empty($customerCompany)) {
            $dataProvider->criteria->addCondition('customer.company LIKE :customer_company');
            $dataProvider->criteria->params[':customer_company'] = "%{$customerCompany}%";
        }
        
        if (!empty($customerOrderNumber)) {
            $dataProvider->criteria->addCondition('saleHeader.customer_order_number LIKE :customer_order_number');
            $dataProvider->criteria->params[':customer_order_number'] = "%{$customerOrderNumber}%";
        }

        $startDate = (isset($_GET['StartDate'])) ? $_GET['StartDate'] : '';
        $endDate = (isset($_GET['EndDate'])) ? $_GET['EndDate'] : '';

        if ($startDate != '' || $endDate != '') {
            $startDate = (empty($startDate)) ? date('Y-m-d') : $startDate;
            $endDate = (empty($endDate)) ? date('Y-m-d') : $endDate;

            $dataProvider->criteria->addBetweenCondition('t.date', $startDate, $endDate);
        }

        $arr_category = array();
        if (isset($_GET['SaveExcel'])) {
            if (isset($_GET['selectedIds'])) {
                foreach ($_GET['selectedIds'] as $id) {
                    $saleInvoice = $this->loadModel($id);
                    array_push($arr_category, $saleInvoice->attributes);
                }
            }
        }

        if ($arr_category) {
            if (isset($_GET['SaveExcel']))
                $this->saveToExcel($arr_category, array('startDate' => $startDate, 'endDate' => $endDate));
        }

        $this->render('admin', array(
            'saleInvoice' => $saleInvoice,
            'dataProvider' => $dataProvider,
            'customerCompany' => $customerCompany,
            'customerOrderNumber' => $customerOrderNumber,
            'workOrderOrdinal' => $workOrderOrdinal,
            'workOrderMonth' => $workOrderMonth,
            'workOrderYear' => $workOrderYear,
        ));
    }

    public function actionAjaxJsonDateChanged($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $saleInvoice = $this->instantiate($id);
            $this->loadState($saleInvoice);

            $workOrderCuttingHeader = WorkOrderCuttingHeader::model()->findByPk($saleInvoice->header->work_order_cutting_header_id);

            $date = $_POST['SaleInvoiceHeader']['date'];

            $dueDays = $workOrderCuttingHeader->saleHeader->customer->invoice_due_days;
            $dueDate = date('Y-m-d', strtotime("+{$dueDays} days", strtotime($date)));

            $object = array(
                'due_date_formatted' => CHtml::encode(Yii::app()->dateFormatter->format('yyyy-MM-dd', strtotime($dueDate))),
                'due_date_label' => CHtml::encode(Yii::app()->dateFormatter->format('d MMMM yyyy', strtotime($dueDate))),
//                'customer_top' => $workOrderCuttingHeader->saleHeader->customer->invoice_due_days . ' hari',
            );

            echo CJSON::encode($object);
        }
    }

    public function actionAjaxJsonTotal($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $saleInvoice = $this->instantiate($id);
            $this->loadState($saleInvoice);
            
            $total= CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($saleInvoice->details[$index], 'total')));         
            $subTotal= CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00',$saleInvoice->subTotal));    
            $ppn = CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $saleInvoice->calculatedTax));
            $pph = CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $saleInvoice->calculatedTaxIncome));
            $grandTotal = CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $saleInvoice->grandTotal));

            echo CJSON::encode(array(
                'total' => $total,
                'subTotal' => $subTotal,
                'ppn' => $ppn,
                'pph' => $pph,
                'grandTotal' => $grandTotal,
            )); 
        }
    }

    public function actionAjaxJsonGrandTotal($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $saleInvoice = $this->instantiate($id);

            $this->loadState($saleInvoice);

            $ppn = CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $saleInvoice->calculatedTax));
            $pph = CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $saleInvoice->calculatedTaxIncome));
            $grandTotal = CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $saleInvoice->grandTotal));

            echo CJSON::encode(array(
                'ppn' => $ppn,
                'pph' => $pph,
                'grandTotal' => $grandTotal,
            ));
        }
    }

    public function instantiate($id) {
        if (empty($id))
            $saleInvoice = new SaleInvoiceComponent(new SaleInvoiceHeader, array());
        else {
            $saleInvoiceHeader = $this->loadModel($id);
            $saleInvoice = new SaleInvoiceComponent($saleInvoiceHeader, $saleInvoiceHeader->saleInvoiceDetails);
        }
        return $saleInvoice;
    }

    public function loadModel($id) {
        $model = SaleInvoiceHeader::model()->findByPk($id);
        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        return $model;
    }

    protected function loadState(&$saleInvoice) {
        if (isset($_POST['SaleInvoiceHeader'])) {
            $saleInvoice->header->attributes = $_POST['SaleInvoiceHeader'];
        }
        if (isset($_POST['SaleInvoiceDetail'])) {
            foreach ($_POST['SaleInvoiceDetail'] as $i => $item) {
                if (isset($saleInvoice->details[$i]))
                    $saleInvoice->details[$i]->attributes = $item;
                else {
                    $detail = new SaleInvoiceDetail();
                    $detail->attributes = $item;
                    $saleInvoice->details[] = $detail;
                }
            }
            if (count($_POST['SaleInvoiceDetail']) < count($saleInvoice->details))
                array_splice($saleInvoice->details, $i + 1);
        }
        else
            $saleInvoice->details = array();
    }

    protected function saveToExcel($arr_category, array $options = array()) {

        spl_autoload_unregister(array('YiiBase', 'autoload'));
        include_once Yii::getPathOfAlias('ext.phpexcel.Classes') . DIRECTORY_SEPARATOR . 'PHPExcel.php';
        spl_autoload_register(array('YiiBase', 'autoload'));

        $objPHPExcel = new PHPExcel();

        $documentProperties = $objPHPExcel->getProperties();
        $documentProperties->setCreator('Sinar Putra Metalindo');
        $documentProperties->setTitle('Faktur Pajak Penjualan');

        $worksheet = $objPHPExcel->setActiveSheetIndex(0);
        $worksheet->setTitle('Faktur Pajak Penjualan');

        $worksheet->getColumnDimension('A')->setAutoSize(true);
        $worksheet->getColumnDimension('B')->setAutoSize(true);
        $worksheet->getColumnDimension('C')->setAutoSize(true);
        $worksheet->getColumnDimension('D')->setAutoSize(true);
        $worksheet->getColumnDimension('E')->setAutoSize(true);
        $worksheet->getColumnDimension('F')->setAutoSize(true);
        $worksheet->getColumnDimension('G')->setAutoSize(true);
        $worksheet->getColumnDimension('H')->setAutoSize(true);
        $worksheet->getColumnDimension('I')->setAutoSize(true);
        $worksheet->getColumnDimension('J')->setAutoSize(true);
        $worksheet->getColumnDimension('K')->setAutoSize(true);
        $worksheet->getColumnDimension('L')->setAutoSize(true);
        $worksheet->getColumnDimension('M')->setAutoSize(true);
        $worksheet->getColumnDimension('N')->setAutoSize(true);
        $worksheet->getColumnDimension('P')->setAutoSize(true);
        $worksheet->getColumnDimension('Q')->setAutoSize(true);
        $worksheet->getColumnDimension('R')->setAutoSize(true);
        $worksheet->getColumnDimension('S')->setAutoSize(true);


        $worksheet->getStyle('A1')->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_CENTER);
        $worksheet->getStyle('A1:S3')->getFont()->setBold(true);

        $worksheet->setCellValue('A1', 'FK');
        $worksheet->setCellValue('B1', 'KD_JENIS_TRANSAKSI');
        $worksheet->setCellValue('C1', 'FG_PENGGANTI');
        $worksheet->setCellValue('D1', 'NOMOR_FAKTUR');
        $worksheet->setCellValue('E1', 'MASA_PAJAK');
        $worksheet->setCellValue('F1', 'TAHUN_PAJAK');
        $worksheet->setCellValue('G1', 'TANGGAL_FAKTUR');
        $worksheet->setCellValue('H1', 'NPWP');
        $worksheet->setCellValue('I1', 'NAMA');
        $worksheet->setCellValue('J1', 'ALAMAT_LENGKAP');
        $worksheet->setCellValue('K1', 'JUMLAH_DPP');
        $worksheet->setCellValue('L1', 'JUMLAH_PPN');
        $worksheet->setCellValue('M1', 'JUMLAH PPNBM');
        $worksheet->setCellValue('N1', 'ID_KETERANGAN_TAMBAHAN');
        $worksheet->setCellValue('O1', 'FG_UANG_MUKA');
        $worksheet->setCellValue('P1', 'UANG_MUKA_DPP');
        $worksheet->setCellValue('Q1', 'UANG_MUKA_PPN');
        $worksheet->setCellValue('R1', 'UANG_MUKA_PPNBM');
        $worksheet->setCellValue('S1', 'REFERENSI');
        $worksheet->setCellValue('T1', 'KODE_DOKUMEN_PENDUKUNG');

        $worksheet->setCellValue('A2', 'LT');
        $worksheet->setCellValue('B2', 'NPWP');
        $worksheet->setCellValue('C2', 'NAMA');
        $worksheet->setCellValue('D2', 'JALAN');
        $worksheet->setCellValue('E2', 'BLOK');
        $worksheet->setCellValue('F2', 'NOMOR');
        $worksheet->setCellValue('G2', 'RT');
        $worksheet->setCellValue('H2', 'RW');
        $worksheet->setCellValue('I2', 'KECAMATAN');
        $worksheet->setCellValue('J2', 'KELURAHAN');
        $worksheet->setCellValue('K2', 'KABUPATEN');
        $worksheet->setCellValue('L2', 'PROPINSI');
        $worksheet->setCellValue('M2', 'KODE_POS');
        $worksheet->setCellValue('N2', 'NOMOR_TELEPON');

        $worksheet->setCellValue('A3', 'OF');
        $worksheet->setCellValue('B3', 'KODE_OBJEK');
        $worksheet->setCellValue('C3', 'NAMA');
        $worksheet->setCellValue('D3', 'HARGA_SATUAN');
        $worksheet->setCellValue('E3', 'JUMLAH_BARANG');
        $worksheet->setCellValue('F3', 'HARGA_TOTAL');
        $worksheet->setCellValue('G3', 'DISKON');
        $worksheet->setCellValue('H3', 'DPP');
        $worksheet->setCellValue('I3', 'PPN');
        $worksheet->setCellValue('J3', 'TARIF_PPNBM');
        $worksheet->setCellValue('K3', 'PPNBM');

        $counter = 4;
        foreach ($arr_category as $i => $header) {
            $saleInvoice = SaleInvoiceHeader::model()->findByPk($header['id']);

            $worksheet->setCellValue("A{$counter}", 'FK');
            $objPHPExcel->getActiveSheet()->setCellValueExplicit("B{$counter}", '01', PHPExcel_Cell_DataType::TYPE_STRING);
            $worksheet->setCellValue("C{$counter}", '0');

            $invoiceNumber = $saleInvoice->tax_number;
            $invoiceNumber = str_replace('.', '', $invoiceNumber);
            $invoiceNumber = str_replace('-', '', $invoiceNumber);
            $invoiceNumber = substr($invoiceNumber, 3);

            $worksheet->setCellValueExplicit("D{$counter}", $invoiceNumber, PHPExcel_Cell_DataType::TYPE_STRING);
            $worksheet->setCellValue("E{$counter}", Yii::app()->dateFormatter->format("MM", strtotime($saleInvoice['date'])));
            $worksheet->setCellValue("F{$counter}", Yii::app()->dateFormatter->format("yyyy", strtotime($saleInvoice['date'])));
            $worksheet->setCellValue("G{$counter}", Yii::app()->dateFormatter->format("dd/MM/yyyy", strtotime($saleInvoice['date'])));

            $worksheet->getStyle("H{$counter}")->getNumberFormat()->setFormatCode(PHPExcel_Style_NumberFormat::FORMAT_TEXT);

            $npwp = str_replace('.', '', CHtml::value($saleInvoice, 'customer.tax_registration_number'));
            $npwp = str_replace('-', '', $npwp);

            $worksheet->setCellValueExplicit("H{$counter}", $npwp, PHPExcel_Cell_DataType::TYPE_STRING);
            $worksheet->setCellValue("I{$counter}", strtoupper(CHtml::value($saleInvoice, 'customer.company')));
            $worksheet->setCellValue("J{$counter}", strtoupper(CHtml::value($saleInvoice, 'customer.tax_address_main')));
            $worksheet->setCellValue("K{$counter}", floor(CHtml::encode(CHtml::value($saleInvoice, 'subTotal'))));
            $worksheet->setCellValue("L{$counter}", round(CHtml::encode(CHtml::value($saleInvoice, 'totalTaxForm'))));
            $worksheet->setCellValue("M{$counter}", '0');
            $worksheet->setCellValue("N{$counter}", '0');
            $worksheet->setCellValue("O{$counter}", '0');
            $worksheet->setCellValue("P{$counter}", '0');
            $worksheet->setCellValue("Q{$counter}", '0');
            $worksheet->setCellValue("R{$counter}", '0');
            $worksheet->setCellValue("S{$counter}", CHtml::encode($saleInvoice->getCodeNumber(SaleInvoiceHeader::CN_CONSTANT)));
            $worksheet->setCellValue("T{$counter}", '');

            $counter++;

            $nomor = 1;
            foreach ($saleInvoice->saleInvoiceDetails as $i => $detail) {
                if ($detail->is_inactive == 0) {
                    $worksheet->setCellValue("A{$counter}", 'OF');
                    $worksheet->setCellValue("B{$counter}", CHtml::value($detail, 'workOrderCuttingDetail.job_number'));

                    $worksheet->getStyle("C{$counter}")->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_LEFT);
                    $worksheet->setCellValue("C{$counter}", 
                        CHtml::value($saleInvoice, "note") . " " .
                        CHtml::value($detail, "workOrderCuttingDetail.product_name") . " - " .
                        CHtml::encode(CHtml::value($detail, 'workOrderCuttingDetail.height_quote')) . " x " .
                        CHtml::encode(($detail->workOrderCuttingDetail->product_category_id == 2) ? " " : CHtml::value($detail, 'workOrderCuttingDetail.width_quote')) . CHtml::encode(($detail->workOrderCuttingDetail->product_category_id == 2) ? "" : " x ") .
                        CHtml::encode(CHtml::value($detail, 'workOrderCuttingDetail.length_quote')) . " || " .
                        CHtml::encode(CHtml::value($detail, 'workOrderCuttingDetail.height_request')) . " x " .
                        CHtml::encode(($detail->workOrderCuttingDetail->product_category_id == 2) ? " " : CHtml::value($detail, 'workOrderCuttingDetail.width_request')) . CHtml::encode(($detail->workOrderCuttingDetail->product_category_id == 2) ? "" : " x ") .
                        CHtml::encode(CHtml::value($detail, 'workOrderCuttingDetail.length_request'))
                    );

                    $worksheet->setCellValue("D{$counter}", CHtml::encode(CHtml::value($detail, 'unitPriceForTaxForm')));
                    $worksheet->setCellValue("E{$counter}", CHtml::encode(CHtml::value($detail, 'quantity')));
                    $worksheet->setCellValue("F{$counter}", CHtml::encode(CHtml::value($detail, 'total')));
                    $worksheet->getStyle("G{$counter}")->getAlignment()->setHorizontal(PHPExcel_Style_Alignment::HORIZONTAL_RIGHT);
                    $worksheet->setCellValue("G{$counter}", '0');
                    $worksheet->setCellValue("H{$counter}", floor(CHtml::encode(CHtml::value($detail, 'total'))));
                    $worksheet->setCellValue("I{$counter}", round(CHtml::encode(CHtml::value($detail, 'totalWithTax'))));
                    $worksheet->setCellValue("J{$counter}", CHtml::encode(0));
                    $worksheet->setCellValue("K{$counter}", CHtml::encode(0));

                    $counter++;
                }
            }

            $counter++;
        }

        header('Content-Disposition: attachment;filename="Faktur Pajak.csv"');
        header('Cache-Control: max-age=0');

        $objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'CSV');
        $objWriter->save('php://output');

        Yii::app()->end();
    }

}
