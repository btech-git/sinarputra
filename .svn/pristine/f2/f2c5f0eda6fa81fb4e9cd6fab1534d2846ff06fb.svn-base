<?php

class ProductionCutting extends CComponent {

    public $header;
    public $details;

    public function __construct($header, array $details) {
        $this->header = $header;
        $this->details = $details;
    }

    public function generateCodeNumber($currentMonth, $currentYear) {
        $header = ProductionCuttingHeader::model()->find(array(
            'condition' => 'cn_year = :cn_year AND cn_month = :cn_month',
            'params' => array(':cn_year' => $currentYear, ':cn_month' => $currentMonth),
            'order' => 'cn_year DESC, cn_month DESC, cn_ordinal DESC',
        ));

        if ($header !== null)
            $this->header->setCodeNumber($header->cn_ordinal, $header->cn_month, $header->cn_year);

        $this->header->setCodeNumberByNext($currentMonth, $currentYear);
    }

    public function addDetails($productionPlanningId) {
        $sql = "SELECT wo.quantity - COALESCE(SUM(pc.quantity), 0) AS quantity_remaining, 
                wo.length, wo.width, wo.height, wo.weight, 
                wo.job_group AS job_group, wo.planning_date AS planning_date, wo.machine_id AS machine_id,
                wo.id AS production_planning_cutting_detail_id
                FROM " . ProductionPlanningCuttingDetail::model()->tableName() . " wo
                LEFT OUTER JOIN " . ProductionCuttingDetail::model()->tableName() . " pc
                ON wo.id = pc.production_planning_cutting_detail_id
                WHERE wo.production_planning_cutting_header_id = :production_planning_cutting_header_id
                GROUP BY wo.id
                HAVING quantity_remaining > 0
				ORDER BY wo.id";

        $resultSet = Yii::app()->db->createCommand($sql)->queryAll(true, array(':production_planning_cutting_header_id' => $productionPlanningId));

        $this->details = array();

        foreach ($resultSet as $row) {
            $detail = new ProductionCuttingDetail();

            $detail->production_planning_cutting_detail_id = $row['production_planning_cutting_detail_id'];
            $detail->length = $row['length'];
            $detail->width = $row['width'];
            $detail->height = $row['height'];
            $detail->weight = $row['weight'];
            $detail->job_group = $row['job_group'];
            $detail->production_date = $row['planning_date'];
            $detail->machine_id = $row['machine_id'];
            $detail->productionPlanningQuantity = $row['quantity_remaining'];
            $this->details[] = $detail;
        }
    }

    public function validateDetailsCount() {
        $valid = true;

        if (count($this->details) === 0)
            $valid = false;

        return $valid;
    }

    public function validateDetailsUnique() {
        $valid = true;

        $count = count($this->details);
        for ($i = 0; $i < $count; $i++) {
            for ($j = $i; $j < $count; $j++) {
                if ($i === $j)
                    continue;

                if ($this->details[$i]->production_planning_cutting_detail_id
                        === $this->details[$j]->production_planning_cutting_detail_id) {
                    $valid = false;
                    $this->header->addError('error', 'Detail product tidak boleh sama.');
                    break;
                }
            }
        }

        return $valid;
    }

    public function validate() {
        $valid = $this->header->validate();
        if (!$valid)
            $this->header->addError('error', 'Header Error');

        foreach ($this->details as $detail) {
            $fields = array(
                'length',
                'height',
                'quantity',
                'weight'
            );
            $valid = $detail->validate($fields) && $valid;

            if (!$valid)
                break;
        }

        return $valid;
    }

    public function flush() {

        $this->header->cn_ordinal = $this->header->productionPlanningCuttingHeader->cn_ordinal;
        $this->header->cn_month = $this->header->productionPlanningCuttingHeader->cn_month;
        $this->header->cn_year = $this->header->productionPlanningCuttingHeader->cn_year;

        $valid = $this->header->save(false);

        foreach ($this->details as $detail) {
            if ($detail->quantity <= 0)
                continue;
            
            $detail->production_cutting_header_id = $this->header->id;
            $detail->job_group = $detail->employee->job_group;
            $detail->production_date = $this->header->date;
            
            $valid = $detail->save(false) && $valid;
        }

        $valid = $this->syncProductionPlanningCuttingHeader(true) && $valid;
        
        return $valid;
    }

    public function save($dbConnection) {
        $dbTransaction = $dbConnection->beginTransaction();
        try {
            $valid = $this->validate() && IdempotentManager::build()->save() && $this->flush();

            if ($valid)
                $dbTransaction->commit();
            else
                $dbTransaction->rollback();
        } catch (Exception $e) {
            $dbTransaction->rollback();
            $valid = false;
            $this->header->addError('error', $e->getMessage());
        }

        return $valid;
    }
    
    public function syncProductionPlanningCuttingHeader($isSaved) {
        $detailIds = array();
        foreach ($this->details as $detail) {
            $detailIds[] = $detail->id;
        }
        
        $productionPlanningCuttingHeader = $this->header->productionPlanningCuttingHeader;
        $totalQuantityRemaining = 0;
        foreach ($productionPlanningCuttingHeader->productionPlanningCuttingDetails as $productionPlanningCuttingDetail) {
            $totalQuantityRemaining += $productionPlanningCuttingDetail->quantity;
            
            foreach ($productionPlanningCuttingDetail->productionCuttingDetails as $productionCuttingDetail) {
                if (!in_array($productionCuttingDetail->id, $detailIds)) {
                    $totalQuantityRemaining -= $productionCuttingDetail->quantity;
                }
            }
        }
        if ($isSaved) {
            foreach ($this->details as $detail) {
                $totalQuantityRemaining -= $detail->quantity;
            }
        }
        $productionPlanningCuttingHeader->total_quantity_production_remaining = $totalQuantityRemaining;
        $valid = $productionPlanningCuttingHeader->update(array('total_quantity_production_remaining'));
        
        return $valid;
    }

    public function delete($dbConnection) {
        $dbTransaction = $dbConnection->beginTransaction();
        try {
            $valid = true;
            if ($this->header->productionPlanningCuttingDetails != NULL) {
                foreach ($this->header->productionPlanningCuttingDetails as $detail) {
                    $detail->is_inactive = ActiveRecord::INACTIVE;
                    $valid = $valid && $detail->update(array('is_inactive'));
                }
            }

            $this->header->is_inactive = ActiveRecord::INACTIVE;
            $valid = $valid && $this->header->update(array('is_inactive'));
        
            $valid = $this->syncProductionPlanningCuttingHeader(false) && $valid;

            if ($valid)
                $dbTransaction->commit();
            else
                $dbTransaction->rollBack();
        } catch (Exception $e) {
            $dbTransaction->rollback();
        }

        return $valid;
    }
}
