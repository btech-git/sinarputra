<?php

/**
 * @property integer $id
 * @property integer $cn_ordinal
 * @property integer $cn_month
 * @property integer $cn_year
 * @property string $date
 * @property string $note
 * @property integer $production_miling_header_id
 * @property integer $work_order_cutting_header_id
 * @property integer $admin_id
 * @property integer $is_delivered
 * @property integer $is_inactive
 *
 * @property DeliveryHeader[] $deliveryHeaders
 * @property QualityControlMilingDetail[] $qualityControlMilingDetails
 * @property Admin $admin
 * @property WorkOrderCuttingHeader $workOrderCuttingHeader
 * @property ProductionMilingHeader $productionMilingHeader
 * @property WorkOrderReplacementHeader[] $workOrderReplacementHeaders
 */
class QualityControlMilingHeaderBase extends MonthlyTransactionActiveRecord {

    public function tableName() {
        return 'tblsp_quality_control_miling_header';
    }

    public function rules() {
        return array(
            array('cn_ordinal, cn_month, cn_year, date, production_miling_header_id, work_order_cutting_header_id, admin_id', 'required'),
            array('cn_ordinal, cn_month, cn_year, production_miling_header_id, work_order_cutting_header_id, admin_id, is_delivered, is_inactive', 'numerical', 'integerOnly' => true),
            array('note', 'safe'),
            // The following rule is used by search().
            array('id, cn_ordinal, cn_month, cn_year, date, note, production_miling_header_id, work_order_cutting_header_id, admin_id, is_delivered, is_inactive', 'safe', 'on' => 'search'),
        );
    }

    public function relations() {
        return array(
            'deliveryHeaders' => array(self::HAS_MANY, 'DeliveryHeader', 'quality_control_miling_header_id'),
            'qualityControlMilingDetails' => array(self::HAS_MANY, 'QualityControlMilingDetail', 'quality_control_miling_header_id'),
            'admin' => array(self::BELONGS_TO, 'Admin', 'admin_id'),
            'workOrderCuttingHeader' => array(self::BELONGS_TO, 'WorkOrderCuttingHeader', 'work_order_cutting_header_id'),
            'productionMilingHeader' => array(self::BELONGS_TO, 'ProductionMilingHeader', 'production_miling_header_id'),
            'workOrderReplacementHeaders' => array(self::HAS_MANY, 'WorkOrderReplacementHeader', 'quality_control_miling_header_id'),
        );
    }

    public function attributeLabels() {
        return array(
            'id' => 'ID',
            'cn_ordinal' => 'Cn Ordinal',
            'cn_month' => 'Cn Month',
            'cn_year' => 'Cn Year',
            'date' => 'Date',
            'note' => 'Note',
            'production_miling_header_id' => 'Production Miling Header',
            'work_order_cutting_header_id' => 'Work Order Cutting Header',
            'admin_id' => 'Admin',
            'is_delivered' => 'Is Delivered',
            'is_inactive' => 'Is Inactive',
        );
    }

    public function search() {
        $criteria = new CDbCriteria;

        $criteria->compare('t.id', $this->id);
        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.production_miling_header_id', $this->production_miling_header_id);
        $criteria->compare('t.work_order_cutting_header_id', $this->work_order_cutting_header_id);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.is_delivered', $this->is_delivered);
        $criteria->compare('t.is_inactive', $this->is_inactive);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
            'pagination' => array(
                'pageSize' => 100,
            ),
        ));
    }

}
