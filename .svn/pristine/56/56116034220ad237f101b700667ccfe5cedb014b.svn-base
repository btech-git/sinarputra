<?php

class EmployeeController extends CrudController {

    public $layout = '//layouts/column2';

    public function filters() {
        return array(
            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'create') {
            if (!Yii::app()->user->checkAccess('hrgaCreateMaster'))
                $this->redirect(array('/site/login'));
        } 
        if ($filterChain->action->id === 'update' || $filterChain->action->id === 'delete') {
            if (!Yii::app()->user->checkAccess('hrgaEditMaster'))
                $this->redirect(array('/site/login'));            
        } 
        if ($filterChain->action->id === 'view' || $filterChain->action->id === 'admin') {
            if (!(Yii::app()->user->checkAccess('hrgaCreateMaster') || 
            Yii::app()->user->checkAccess('hrgaEditMaster') || 
            Yii::app()->user->checkAccess('hrgaViewMaster')))
                $this->redirect(array('/site/login'));            
        }

        $filterChain->run();
    }

    public function loadState($model) {
        if (isset($_POST['Employee'])) {
            $model->header->attributes = $_POST['Employee'];
        }
        if (isset($_POST['EmployeeFamilyRelationship'])) {
            foreach ($_POST['EmployeeFamilyRelationship'] as $i => $item) {
                if (isset($model->detailRelationships[$i]))
                    $model->detailRelationships[$i]->attributes = $item;
                else {
                    $detail = new EmployeeFamilyRelationship();
                    $detail->attributes = $item;
                    $model->detailRelationships[] = $detail;
                }
            }
            if (count($_POST['EmployeeFamilyRelationship']) < count($model->detailRelationships))
                array_splice($model->detailRelationships, $i + 1);
        }
        else
            $model->detailRelationships = array();

        if (isset($_POST['EmployeeFormalEducation'])) {
            foreach ($_POST['EmployeeFormalEducation'] as $i => $item) {
                if (isset($model->detailEducations[$i]))
                    $model->detailEducations[$i]->attributes = $item;
                else {
                    $detail = new EmployeeFormalEducation();
                    $detail->attributes = $item;
                    $model->detailEducations[] = $detail;
                }
            }
            if (count($_POST['EmployeeFormalEducation']) < count($model->detailEducations))
                array_splice($model->detailEducations, $i + 1);
        }
        else
            $model->detailEducations = array();

        if (isset($_POST['EmployeeJobExperience'])) {
            foreach ($_POST['EmployeeJobExperience'] as $i => $item) {
                if (isset($model->detailExperiences[$i]))
                    $model->detailExperiences[$i]->attributes = $item;
                else {
                    $detail = new EmployeeJobExperience();
                    $detail->attributes = $item;
                    $model->detailExperiences[] = $detail;
                }
            }
            if (count($_POST['EmployeeJobExperience']) < count($model->detailExperiences))
                array_splice($model->detailExperiences, $i + 1);
        }
        else
            $model->detailExperiences = array();
    }

    public function instantiate($id) {

        if (empty($id))
            $model = new EmployeeComponent(new Employee, array(), array(), array());
        else {
            $header = $this->loadModel($id);
            $model = new EmployeeComponent($header, $header->employeeFamilyRelationships, $header->employeeFormalEducations, $header->employeeJobExperiences);
        }

        return $model;
    }

    public function saveImageFile($model) {
        if ($model->header->file) {
            $originalPath = dirname(Yii::app()->request->scriptFile) . '/images/employee/' . $model->header->file_extension;
            $model->header->file->saveAs($originalPath);

            require_once( dirname(Yii::app()->request->scriptFile) . '/protected/extensions/phpthumb/ThumbLib.inc.php' );

            $image = PhpThumbFactory::create($originalPath);
            $image->resize(1024, 768)->save($originalPath);
        }
        
        if ($model->header->file_signature) {
            $originalPath = dirname(Yii::app()->request->scriptFile) . '/images/signature/' . $model->header->file_extension_signature;
            $model->header->file_signature->saveAs($originalPath);

            require_once( dirname(Yii::app()->request->scriptFile) . '/protected/extensions/phpthumb/ThumbLib.inc.php' );

            $image = PhpThumbFactory::create($originalPath);
            $image->resize(1024, 768)->save($originalPath);
        }
    }

    public function actionView($id) {
        $this->render('view', array(
            'model' => $this->loadModel($id),
        ));
    }

    public function actionCreate() {
        $model = $this->instantiate(null);
        $model->header->permanent_start_date = '1111-11-11';
        $model->header->identity_expired = '1111-11-11';
        $model->header->driver_license_expired = '1111-11-11';
        $model->header->resignation_date = '1111-11-11';

        if (isset($_POST['Employee'])) {
            $this->loadState($model);

            $fileName = CUploadedFile::getInstanceByName('file');
            $model->header->file = $fileName;
            $model->header->file_extension = $fileName;

            $fileSignature = CUploadedFile::getInstanceByName('file_signature');
            $model->header->file_signature = $fileSignature;
            $model->header->file_extension_signature = $fileSignature;

            if ($model->save(Yii::app()->db)) {
                $this->saveImageFile($model);
                $this->redirect(array('view', 'id' => $model->header->id));
            }
        }

        $this->render('create', array(
            'model' => $model,
        ));
    }

    public function actionUpdate($id) {
        $model = $this->instantiate($id);

        if (isset($_POST['Employee']) || isset($_POST['EmployeeJobExperience']) || isset($_POST['EmployeeFamilyRelationShip']) || isset($_POST['EmployeeFormalEducation'])) {
            $this->loadState($model);

            $fileName = CUploadedFile::getInstanceByName('file');
            if ($fileName != null) {
                $model->header->file = $fileName;
                $model->header->file_extension = $fileName;
            }

            $fileSignature = CUploadedFile::getInstanceByName('file_signature');
            if ($fileSignature != null) {
                $model->header->file_signature = $fileSignature;
                $model->header->file_extension_signature = $fileSignature;
            }

            if ($model->save(Yii::app()->db)) {
                $this->saveImageFile($model);
                $this->redirect(array('view', 'id' => $model->header->id));
            }
        }

        $this->render('update', array(
            'model' => $model,
        ));
    }

    public function actionDelete($id) {
        if (Yii::app()->request->isPostRequest) {
            $this->loadModel($id)->delete();

            if (!isset($_GET['ajax']))
                $this->redirect(isset($_POST['returnUrl']) ? $_POST['returnUrl'] : array('admin'));
        }
        else
            throw new CHttpException(400, 'Invalid request. Please do not repeat this request again.');
    }

    public function actionIndex() {
        $dataProvider = new CActiveDataProvider('Employee');
        $this->render('index', array(
            'dataProvider' => $dataProvider,
        ));
    }

    public function actionAdmin() {
        $model = new Employee('search');
        $model->unsetAttributes();
        if (isset($_GET['Employee']))
            $model->attributes = $_GET['Employee'];


        if (isset($_GET['Export'])) {
            $this->saveToExcel(Employee::model()->findAll());
        }

        $this->render('admin', array(
            'model' => $model,
        ));
    }

    public function loadModel($id) {
        $model = Employee::model()->findByPk($id);
        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        return $model;
    }

    public function actionAjaxHtmlAddDetailRelationship($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $model = $this->instantiate($id);
            $this->loadState($model);

            $model->addDetailRelationship();

            $this->renderPartial('_detail_relationship', array(
                'model' => $model,
            ));
        }
    }

