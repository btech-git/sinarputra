<?php

/**
 * @property integer $id
 * @property integer $cn_ordinal
 * @property integer $cn_month
 * @property integer $cn_year
 * @property string $date
 * @property string $date_approval
 * @property string $note
 * @property string $time_created
 * @property integer $work_order_cutting_header_id
 * @property integer $quality_control_cutting_header_id
 * @property integer $quality_control_miling_header_id
 * @property integer $admin_id
 * @property integer $admin_id_approval
 * @property integer $is_service
 * @property integer $is_approved
 * @property integer $is_inactive
 *
 * @property ProductionPlanningCuttingHeader[] $productionPlanningCuttingHeaders
 * @property ProductionPlanningMilingHeader[] $productionPlanningMilingHeaders
 * @property WorkOrderReplacementDetail[] $workOrderReplacementDetails
 * @property WorkOrderCuttingHeader $workOrderCuttingHeader
 * @property Admin $admin
 * @property Admin $adminIdApproval
 * @property QualityControlCuttingHeader $qualityControlCuttingHeader
 * @property QualityControlMilingHeader $qualityControlMilingHeader
 */
class WorkOrderReplacementHeaderBase extends MonthlyTransactionActiveRecord {

    public function tableName() {
        return 'tblsp_work_order_replacement_header';
    }

    public function rules() {
        return array(
            array('cn_ordinal, cn_month, cn_year, date, time_created, work_order_cutting_header_id, admin_id', 'required'),
            array('cn_ordinal, cn_month, cn_year, work_order_cutting_header_id, quality_control_cutting_header_id, quality_control_miling_header_id, admin_id, admin_id_approval, is_service, is_approved, is_inactive', 'numerical', 'integerOnly' => true),
            array('date_approval, note', 'safe'),
            // The following rule is used by search().
            array('id, cn_ordinal, cn_month, cn_year, date, date_approval, note, time_created, work_order_cutting_header_id, quality_control_cutting_header_id, quality_control_miling_header_id, admin_id, admin_id_approval, is_service, is_approved, is_inactive', 'safe', 'on' => 'search'),
        );
    }

    public function relations() {
        return array(
            'productionPlanningCuttingHeaders' => array(self::HAS_MANY, 'ProductionPlanningCuttingHeader', 'work_order_replacement_header_id'),
            'productionPlanningMilingHeaders' => array(self::HAS_MANY, 'ProductionPlanningMilingHeader', 'work_order_replacement_header_id'),
            'workOrderReplacementDetails' => array(self::HAS_MANY, 'WorkOrderReplacementDetail', 'work_order_replacement_header_id'),
            'workOrderCuttingHeader' => array(self::BELONGS_TO, 'WorkOrderCuttingHeader', 'work_order_cutting_header_id'),
            'admin' => array(self::BELONGS_TO, 'Admin', 'admin_id'),
            'adminIdApproval' => array(self::BELONGS_TO, 'Admin', 'admin_id_approval'),
            'qualityControlCuttingHeader' => array(self::BELONGS_TO, 'QualityControlCuttingHeader', 'quality_control_cutting_header_id'),
            'qualityControlMilingHeader' => array(self::BELONGS_TO, 'QualityControlMilingHeader', 'quality_control_miling_header_id'),
        );
    }

    public function attributeLabels() {
        return array(
            'id' => 'ID',
            'cn_ordinal' => 'Cn Ordinal',
            'cn_month' => 'Cn Month',
            'cn_year' => 'Cn Year',
            'date' => 'Date',
            'date_approval' => 'Date Approval',
            'note' => 'Note',
            'time_created' => 'Time Created',
            'work_order_cutting_header_id' => 'Work Order Cutting Header',
            'quality_control_cutting_header_id' => 'Quality Control Cutting Header',
            'quality_control_miling_header_id' => 'Quality Control Miling Header',
            'admin_id' => 'Admin',
            'admin_id_approval' => 'Admin Id Approval',
            'is_service' => 'Is Service',
            'is_approved' => 'Is Approved',
            'is_inactive' => 'Is Inactive',
        );
    }

    public function search() {
        $criteria = new CDbCriteria;

        $criteria->compare('t.id', $this->id);
        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.date_approval', $this->date_approval, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.time_created', $this->time_created, true);
        $criteria->compare('t.work_order_cutting_header_id', $this->work_order_cutting_header_id);
        $criteria->compare('t.quality_control_cutting_header_id', $this->quality_control_cutting_header_id);
        $criteria->compare('t.quality_control_miling_header_id', $this->quality_control_miling_header_id);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.admin_id_approval', $this->admin_id_approval);
        $criteria->compare('t.is_service', $this->is_service);
        $criteria->compare('t.is_approved', $this->is_approved);
        $criteria->compare('t.is_inactive', $this->is_inactive);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
            'pagination' => array(
                'pageSize' => 100,
            ),
        ));
    }

}
