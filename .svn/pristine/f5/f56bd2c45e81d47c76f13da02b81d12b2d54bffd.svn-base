                        <?php echo CHtml::encode((CHtml::value($detail, 'is_annelying') == 1) ? "Yes" : ""); ?>
                    </td>

                    <?php if ((int)$model->saleHeader->is_service == 1): ?>
                        <td style="text-align: center">
                            <?php echo CHtml::encode((CHtml::value($detail, 'is_cut') == 1) ? "Yes" : ""); ?>
