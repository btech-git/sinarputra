                        <?php echo CHtml::encode(CHtml::value($detail, 'height_quote')); ?>
                    </td>

                    <td style="text-align: center"><!--width-->
                        <?php if ($detail->product_category_id != 2) : ?>
                            <?php echo CHtml::encode(CHtml::value($detail, 'width_quote')); ?>
