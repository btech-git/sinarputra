                        <?php echo CHtml::encode((CHtml::value($detail, 'is_miling') == 1) ? "Yes" : ""); ?>
                    </td>

                    <td style="text-align: center"><!--is annelying-->
                        <?php echo CHtml::encode((CHtml::value($detail, 'is_sidemiling') == 1) ? "Yes" : ""); ?>
