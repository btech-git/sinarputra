<?php

class ReceiveHeader extends ReceiveHeaderBase {

    const CN_CONSTANT = 'RCV';
    const LOCAL = 1;
    const IMPORT = 2;
    const OTHER = 3;
    const LOCAL_LITERAL = 'Lokal';
    const IMPORT_LITERAL = 'Impor';
    const OTHER_LITERAL = 'Lain-lain';

    public static function model($className = __CLASS__) {
        return parent::model($className);
    }

    public function getReceivingType() {
        $type = '';

        if ($this->receiving_type == self::LOCAL)
            $type = self::LOCAL_LITERAL;
        else if ($this->receiving_type == self::IMPORT)
            $type = self::IMPORT_LITERAL;
        else if ($this->receiving_type == self::OTHER)
            $type = self::OTHER_LITERAL;

        return $type;
    }

    public function searchForPurchaseInvoice() {
        $criteria = new CDbCriteria;

        $criteria->addCondition("t.id NOT IN (
            SELECT receive_header_id
            FROM " . PurchaseInvoice::model()->tableName() . "
            WHERE receive_header_id IS NOT NULL
        ) AND t.is_inactive = 0 AND t.purchase_header_id IS NOT NULL AND t.date > '2021-12-31'");

        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.purchase_header_id', $this->purchase_header_id);
        $criteria->compare('t.warehouse_id', $this->warehouse_id);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.is_inactive', 0);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
            'Pagination' => array(
                'PageSize' => 50
            ),
        ));
    }

    public function searchForPurchaseReturn() {
        $criteria = new CDbCriteria;

        $criteria->compare('t.id', $this->id);
        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.purchase_header_id', $this->purchase_header_id);
        $criteria->compare('t.warehouse_id', $this->warehouse_id);
        $criteria->compare('t.supplier_id', $this->supplier_id);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.receiving_type', $this->receiving_type);
        $criteria->compare('t.is_inactive', $this->is_inactive);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
            'Pagination' => array(
                'PageSize' => 50
            ),
        ));
    }

    public function searchWithPaging() {
        $criteria = new CDbCriteria;

        $criteria->compare('t.id', $this->id);
        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.purchase_header_id', $this->purchase_header_id);
        $criteria->compare('t.warehouse_id', $this->warehouse_id);
        $criteria->compare('t.supplier_id', $this->supplier_id);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.receiving_type', $this->receiving_type);
        $criteria->compare('t.is_inactive', $this->is_inactive);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
            'pagination' => array(
                'pageSize' => Yii::app()->user->getState('pageSize', Yii::app()->params['defaultPageSize']),
            ),
            'sort' => array(
                'defaultOrder' => 't.id DESC',
            ),
        ));
    }

    public function getReceiveQuantityTotal($receive) {
        $total = 0;
        foreach ($receive->receiveDetails as $receiveDetail) {
            $total = $total + 1;
        }

        return $total;
    }

    public function getPackingMethod($receive) {
        $total = self::getReceiveQuantityTotal($receive);

        $dus = 0;
        while ($total >= 12) {
            $total -= 12;
            $dus += 1;
        }

        return $dus . ' dus, ' . $total . ' pasang.';
    }

    public function getTotalQuantityByProduct($productId) {
        $totalQuantity = 0.00;

        foreach ($this->receiveDetails(array('with' => array('purchaseDetail' => array('with' => 'product')), 'condition' => 'productr_id = :product__id', 'params' => array(':product_id' => $productId))) as $receiveDetail) {
            $totalQuantity += $receiveDetail->quantity;
        }

        return $totalQuantity;
    }

    public function getSubTotal() {
        $total = 0.00;

        foreach ($this->receiveDetails as $detail) {
            $total += $detail->total;
        }

        return $total;
    }

    public function getDiscountAmount() {
        return $this->purchaseHeader->discount / 100 * $this->getSubTotal();
    }

    public function getTotalBeforeTax() {
        return $this->subTotal - $this->purchaseHeader->discount;
    }

    public function getCalculatedTax() {
        return ((int) $this->purchaseHeader->is_tax === 1) ? $this->getTotalBeforeTax() * .1 : 0.00;
    }

    public function getCalculatedTaxIncome() {
        return ((int) $this->purchaseHeader->is_tax_income === 1) ? $this->getTotalBeforeTax() * .02 : 0.00;
    }

    public function getGrandTotal() {
        return $this->getTotalBeforeTax() + $this->getCalculatedTax() - $this->getCalculatedTaxIncome();
    }
}
