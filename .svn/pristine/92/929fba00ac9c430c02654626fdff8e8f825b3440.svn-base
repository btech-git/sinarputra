Yii::app()->clientScript->registerCss('_report', '
     @page {
        size:auto;
        margin: 5px 0px 0px 0px;
    }

	.width2-1 { width: 10% }
	.width2-2 { width: 10% }
	.width2-3 { width: 10% }
