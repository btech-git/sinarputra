	.width2-7 { width: 10% }
	.width2-8 { width: 10% }
	.width2-9 { width: 10% }
');
?>

<div style="font-weight: bold; text-align: center">
    <div style="font-size: larger"><?php echo Yii::app()->name; ?></div>
    <div style="font-size: larger">Laporan Outstanding Invoice Manual 2</div>
    <div><?php echo CHtml::encode(Yii::app()->dateFormatter->format('d MMMM yyyy', strtotime($startDate))) . ' &nbsp;&ndash;&nbsp; ' . CHtml::encode(Yii::app()->dateFormatter->format('d MMMM yyyy', strtotime($endDate))); ?></div>
</div>

<br />

<table class="report">
    <tr id="header1">
        <th class="width1-1" style="text-align: left;border-bottom: 2px solid;">Tgl Nota</th>
        <th class="width1-2" style="text-align: left;border-bottom: 2px solid;">TOP (hari)</th>
        <th class="width1-3" style="text-align: left;border-bottom: 2px solid;">Remaining TOP</th>
        <th class="width1-4" style="text-align: left;border-bottom: 2px solid;">No Nota</th>
        <th class="width1-5" style="text-align: left;border-bottom: 2px solid;">Customer</th>
        <th class="width1-6" style="text-align: left;border-bottom: 2px solid;">Salesman</th>
        <th class="width1-7" style="text-align: left;border-bottom: 2px solid;">Total</th>
        <th class="width1-8" style="text-align: left;border-bottom: 2px solid;">Pelunasan</th>
        <th class="width1-9" style="text-align: left;border-bottom: 2px solid;">Sisa</th>
    </tr>

    <?php foreach ($materialReceivableSummary->dataProvider->data as $header): ?>
        <?php $dueDays = empty($header->materialReceivableDetails) ? 0 : strtotime($header->materialReceivableDetails[0]->materialReceivableHeader->due_date); ?>
        <?php $remainingDueDays = ($dueDays - strtotime(date('Y-m-d'))) /86400; ?>
        <?php if ($remainingDueDays > 15): ?>
            <tr>
        <?php else: ?>
            <tr style="background-color: red"> 
        <?php endif; ?>
            <td class="width1-1"><?php echo CHtml::encode(Yii::app()->dateFormatter->format('d MMM yyyy', strtotime($header->date))); ?></td>
            <td class="width1-2"><?php echo CHtml::encode(CHtml::value($header, 'customer.invoice_due_days')); ?></td>
            <td class="width1-3"><?php echo $remainingDueDays; ?></td>
            <td class="width2-4" style="text-align: left"><?php echo CHtml::encode($header->getCodeNumber(MaterialInvoiceHeader::CN_CONSTANT)); ?></td>
            <td class="width2-5"><?php echo CHtml::encode(CHtml::value($header, 'customer.company')); ?></td>
            <td class="width1-6"><?php echo CHtml::encode(CHtml::value($header, 'employeeIdSalesman.name')); ?></td>
            <td class="width2-7" style="text-align: right"><?php echo CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($header, 'grand_total'))); ?></td>
            <td class="width2-8" style="text-align: right"><?php echo CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($header, 'total_payment'))); ?></td>
            <td class="width2-9" style="text-align: right"><?php echo CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($header, 'remaining_payment'))); ?></td>
        </tr>
    <?php endforeach; ?>
</table>