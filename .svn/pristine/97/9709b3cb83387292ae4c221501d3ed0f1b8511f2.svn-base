<?php

class QualityControlCuttingController extends Controller {

    public function filters() {
        return array(
            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'create') {
            if (!(Yii::app()->user->checkAccess('qcCuttingCreate')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'delete' || $filterChain->action->id === 'update') {
            if (!(Yii::app()->user->checkAccess('qcCuttingEdit')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'view'
                || $filterChain->action->id === 'memo'
                || $filterChain->action->id === 'admin') {
            if (!(Yii::app()->user->checkAccess('qcCuttingCreate') || Yii::app()->user->checkAccess('qcCuttingEdit')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }

    public function actionProductionCuttingList() {
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';
        $customerPurchaseNumber = isset($_GET['CustomerPurchaseNumber']) ? $_GET['CustomerPurchaseNumber'] : '';
        $workOrderOrdinal = isset($_GET['WorkOrderOrdinal']) ? $_GET['WorkOrderOrdinal'] : '';
        $workOrderMonth = isset($_GET['WorkOrderMonth']) ? $_GET['WorkOrderMonth'] : '';
        $workOrderYear = isset($_GET['WorkOrderYear']) ? $_GET['WorkOrderYear'] : '';

        $productionCuttingHeader = Search::bind(new ProductionCuttingHeader('search'), isset($_GET['ProductionCuttingHeader']) ? $_GET['ProductionCuttingHeader'] : '');
        $productionCuttingHeaderDataProvider = $productionCuttingHeader->searchForQualityControl();
        $productionCuttingHeaderDataProvider->criteria->with = array(
            'productionPlanningCuttingHeader' => array(
                'with' => array(
                    'workOrderCuttingHeader' => array(
                        'with' => array(
                            'saleHeader' => array(
                                'with' => array(
                                    'customer:resetScope'
                                )
                            )
                        )
                    )
                )
            )
        );
 
        if (!empty($workOrderOrdinal)) {
            $productionCuttingHeaderDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_ordinal = :cn_ordinal');
            $productionCuttingHeaderDataProvider->criteria->params[':cn_ordinal'] = $workOrderOrdinal;
        }
        
        if (!empty($workOrderMonth)) {
            $productionCuttingHeaderDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_month = :cn_month');
            $productionCuttingHeaderDataProvider->criteria->params[':cn_month'] = $workOrderMonth;
        }
        
        if (!empty($workOrderYear)) {
            $productionCuttingHeaderDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_year = :cn_year');
            $productionCuttingHeaderDataProvider->criteria->params[':cn_year'] = $workOrderYear;
        }
        
        if (!empty($customerCompany)) {
            $productionCuttingHeaderDataProvider->criteria->addCondition('customer.company LIKE :customer_company');
            $productionCuttingHeaderDataProvider->criteria->params[':customer_company'] = "%{$customerCompany}%";
        }

        $productionCuttingHeaderDataProvider->criteria->addCondition("saleHeader.customer_order_number LIKE :customer_order_number");
        $productionCuttingHeaderDataProvider->criteria->params[':customer_order_number'] = "%{$customerPurchaseNumber}%";

        $this->render('productionCuttingList', array(
            'productionCuttingHeader' => $productionCuttingHeader,
            'productionCuttingHeaderDataProvider' => $productionCuttingHeaderDataProvider,
            'customerCompany' => $customerCompany,
            'customerPurchaseNumber' => $customerPurchaseNumber,
            'workOrderOrdinal' => $workOrderOrdinal,
            'workOrderMonth' => $workOrderMonth,
            'workOrderYear' => $workOrderYear,
        ));
    }

    public function actionCreate($productionCuttingId) {
        $qualityControl = $this->instantiate(null);
        $productionCuttingHeader = ProductionCuttingHeader::model()->findByPk($productionCuttingId);
        $qualityControl->header->admin_id = Yii::app()->user->id;
        $qualityControl->generateCodeNumber(date('m'), date('y'));
        $qualityControl->header->date = date('Y-m-d');
        $qualityControl->header->production_cutting_header_id = $productionCuttingId;
        $qualityControl->header->work_order_cutting_header_id = $productionCuttingHeader->productionPlanningCuttingHeader->work_order_cutting_header_id;
        $qualityControl->addDetails($productionCuttingId);

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($qualityControl);
            
            if ($qualityControl->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $qualityControl->header->id));
        }

        $this->render('create', array(
            'qualityControl' => $qualityControl,
        ));
    }

    public function actionUpdate($id) {
        $qualityControl = $this->instantiate($id);

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($qualityControl);

            if ($qualityControl->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $qualityControl->header->id));
        }

        $this->render('update', array(
            'qualityControl' => $qualityControl,
        ));
    }

    public function actionView($id) {
        $model = $this->loadModel($id);

        $criteria = new CDbCriteria;
        $criteria->compare('quality_control_cutting_header_id', $model->id);

        $detailsDataProvider = new CActiveDataProvider('QualityControlCuttingDetail', array(
            'criteria' => $criteria,
        ));

        $this->render('view', array(
            'model' => $model,
            'detailsDataProvider' => $detailsDataProvider,
        ));
    }

    public function actionAdmin() {
        $model = Search::bind(new QualityControlCuttingHeader('search'), isset($_GET['QualityControlCuttingHeader']) ? $_GET['QualityControlCuttingHeader'] : array());
        $customerCompany = isset($_GET['CustomerCompany']) ? $_GET['CustomerCompany'] : '';
        $customerPurchaseNumber = isset($_GET['CustomerPurchaseNumber']) ? $_GET['CustomerPurchaseNumber'] : '';
        $workOrderOrdinal = isset($_GET['WorkOrderOrdinal']) ? $_GET['WorkOrderOrdinal'] : '';
        $workOrderMonth = isset($_GET['WorkOrderMonth']) ? $_GET['WorkOrderMonth'] : '';
        $workOrderYear = isset($_GET['WorkOrderYear']) ? $_GET['WorkOrderYear'] : '';

        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }

        $modelDataProvider = $model->search();
        $modelDataProvider->criteria->with = array(
            'productionCuttingHeader',
            'workOrderCuttingHeader' => array(
                'with' => array(
                    'saleHeader' => array(
                        'with' => array(
                            'customer:resetScope',
                        )
                    )
                )
            )
        );
           
        if (!empty($workOrderOrdinal)) {
            $modelDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_ordinal = :cn_ordinal');
            $modelDataProvider->criteria->params[':cn_ordinal'] = $workOrderOrdinal;
        }
        
        if (!empty($workOrderMonth)) {
            $modelDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_month = :cn_month');
            $modelDataProvider->criteria->params[':cn_month'] = $workOrderMonth;
        }
        
        if (!empty($workOrderYear)) {
            $modelDataProvider->criteria->addCondition('workOrderCuttingHeader.cn_year = :cn_year');
            $modelDataProvider->criteria->params[':cn_year'] = $workOrderYear;
        }
        
        if (!empty($customerCompany)) {
            $modelDataProvider->criteria->addCondition('customer.company LIKE :customer_company');
            $modelDataProvider->criteria->params[':customer_company'] = "%{$customerCompany}%";
        }

		$modelDataProvider->criteria->addCondition("saleHeader.customer_order_number LIKE :customer_order_number");
		$modelDataProvider->criteria->params[':customer_order_number'] = "%{$customerPurchaseNumber}%";

        $modelDataProvider->criteria->addCondition('t.is_inactive = 0');
        $modelDataProvider->criteria->order = 't.id DESC';

        $this->render('admin', array(
            'model' => $model,
            'modelDataProvider' => $modelDataProvider,
            'customerCompany' => $customerCompany,
            'customerPurchaseNumber' => $customerPurchaseNumber,
            'workOrderOrdinal' => $workOrderOrdinal,
            'workOrderMonth' => $workOrderMonth,
            'workOrderYear' => $workOrderYear,
        ));
    }

    public function actionLabel($detailId) {
        $qualityControlCuttingDetail = QualityControlCuttingDetail::model()->findByPk($detailId);
        
        $this->render('label', array(
            'qualityControlCuttingDetail' => $qualityControlCuttingDetail,
        ));
    }

    public function instantiate($id) {
        if (empty($id))
            $model = new QualityControlCutting(new QualityControlCuttingHeader(), array());
        else {
            $header = $this->loadModel($id);
            $model = new QualityControlCutting($header, $header->qualityControlCuttingDetails);
        }

        return $model;
    }

    public function loadModel($id) {
        $model = QualityControlCuttingHeader::model()->findByPk($id);
        
        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        
        return $model;
    }

    public function loadState($model) {
        if (isset($_POST['QualityControlCuttingHeader']))
            $model->header->attributes = $_POST['QualityControlCuttingHeader'];

        if (isset($_POST['QualityControlCuttingDetail'])) {
            foreach ($_POST['QualityControlCuttingDetail'] as $i => $item) {
                if (isset($model->details[$i]))
                    $model->details[$i]->attributes = $item;
                else {
                    $detail = new QualityControlCuttingDetail();
                    $detail->attributes = $item;
                    $model->details[] = $detail;
                }
            }
            if (count($_POST['QualityControlCuttingDetail']) < count($model->details))
                array_splice($model->details, $i + 1);
        }
        else
            $model->details = array();
    }

}