<?php

/**
 * @property integer $id
 * @property integer $cn_ordinal
 * @property integer $cn_month
 * @property integer $cn_year
 * @property string $date
 * @property string $note
 * @property string $time_created
 * @property string $time_edited
 * @property integer $delivery_period
 * @property integer $payment_period
 * @property integer $valid_period
 * @property integer $cancellation_remark
 * @property integer $customer_id
 * @property integer $employee_id_sales
 * @property integer $admin_id
 * @property integer $admin_id_edit
 * @property integer $is_replacement
 * @property integer $is_tax
 * @property integer $is_logo_printed
 * @property integer $is_confirmed
 * @property integer $is_service
 * @property integer $is_inactive
 *
 * @property QuotationDetailProduct[] $quotationDetailProducts
 * @property QuotationDetailService[] $quotationDetailServices
 * @property Customer $customer
 * @property Admin $admin
 * @property Employee $employeeIdSales
 * @property Admin $adminIdEdit
 * @property SaleHeader[] $saleHeaders
 */
class QuotationHeaderBase extends MonthlyTransactionActiveRecord {

    public function tableName() {
        return 'tblsp_quotation_header';
    }

    public function rules() {
        return array(
            array('cn_ordinal, cn_month, cn_year, date, time_created, customer_id, employee_id_sales, admin_id', 'required'),
            array('cn_ordinal, cn_month, cn_year, delivery_period, payment_period, valid_period, cancellation_remark, customer_id, employee_id_sales, admin_id, admin_id_edit, is_replacement, is_tax, is_logo_printed, is_confirmed, is_service, is_inactive', 'numerical', 'integerOnly' => true),
            array('note, time_edited', 'safe'),
            // The following rule is used by search().
            array('id, cn_ordinal, cn_month, cn_year, date, note, time_created, time_edited, delivery_period, payment_period, valid_period, cancellation_remark, customer_id, employee_id_sales, admin_id, admin_id_edit, is_replacement, is_tax, is_logo_printed, is_confirmed, is_service, is_inactive', 'safe', 'on' => 'search'),
        );
    }

    public function relations() {
        return array(
            'quotationDetailProducts' => array(self::HAS_MANY, 'QuotationDetailProduct', 'quotation_header_id'),
            'quotationDetailServices' => array(self::HAS_MANY, 'QuotationDetailService', 'quotation_header_id'),
            'customer' => array(self::BELONGS_TO, 'Customer', 'customer_id'),
            'admin' => array(self::BELONGS_TO, 'Admin', 'admin_id'),
            'employeeIdSales' => array(self::BELONGS_TO, 'Employee', 'employee_id_sales'),
            'adminIdEdit' => array(self::BELONGS_TO, 'Admin', 'admin_id_edit'),
            'saleHeaders' => array(self::HAS_MANY, 'SaleHeader', 'quotation_header_id'),
        );
    }

    public function attributeLabels() {
        return array(
            'id' => 'ID',
            'cn_ordinal' => 'Cn Ordinal',
            'cn_month' => 'Cn Month',
            'cn_year' => 'Cn Year',
            'date' => 'Date',
            'note' => 'Note',
            'time_created' => 'Time Created',
            'time_edited' => 'Time Edited',
            'delivery_period' => 'Delivery Period',
            'payment_period' => 'Payment Period',
            'valid_period' => 'Valid Period',
            'cancellation_remark' => 'Cancellation Remark',
            'customer_id' => 'Customer',
            'employee_id_sales' => 'Employee Id Sales',
            'admin_id' => 'Admin',
            'admin_id_edit' => 'Admin Id Edit',
            'is_replacement' => 'Is Replacement',
            'is_tax' => 'Is Tax',
            'is_logo_printed' => 'Is Logo Printed',
            'is_confirmed' => 'Is Confirmed',
            'is_service' => 'Is Service',
            'is_inactive' => 'Is Inactive',
        );
    }

    public function search() {
        $criteria = new CDbCriteria;

        $criteria->compare('t.id', $this->id);
        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.time_created', $this->time_created, true);
        $criteria->compare('t.time_edited', $this->time_edited, true);
        $criteria->compare('t.delivery_period', $this->delivery_period);
        $criteria->compare('t.payment_period', $this->payment_period);
        $criteria->compare('t.valid_period', $this->valid_period);
        $criteria->compare('t.cancellation_remark', $this->cancellation_remark);
        $criteria->compare('t.customer_id', $this->customer_id);
        $criteria->compare('t.employee_id_sales', $this->employee_id_sales);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.admin_id_edit', $this->admin_id_edit);
        $criteria->compare('t.is_replacement', $this->is_replacement);
        $criteria->compare('t.is_tax', $this->is_tax);
        $criteria->compare('t.is_logo_printed', $this->is_logo_printed);
        $criteria->compare('t.is_confirmed', $this->is_confirmed);
        $criteria->compare('t.is_service', $this->is_service);
        $criteria->compare('t.is_inactive', $this->is_inactive);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
            'pagination' => array(
                'pageSize' => 100,
            ),
        ));
    }

}
