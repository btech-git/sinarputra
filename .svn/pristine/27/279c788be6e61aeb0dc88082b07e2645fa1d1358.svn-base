<?php

class ReceiveController extends Controller {

    public function filters() {
        return array(
            'access',
        );
    }

    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'create') {
            if (!(Yii::app()->user->checkAccess('receiveCreate')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'delete' || $filterChain->action->id === 'update') {
            if (!(Yii::app()->user->checkAccess('receiveEdit')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'view'
                || $filterChain->action->id === 'memo'
                || $filterChain->action->id === 'admin'
                || $filterChain->action->id === 'ajaxHtmlAddProduct'
                || $filterChain->action->id === 'ajaxHtmlRemoveProduct'
                || $filterChain->action->id === 'ajaxJsonPurchase') {
            if (!(Yii::app()->user->checkAccess('receiveCreate') || Yii::app()->user->checkAccess('receiveEdit')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }

    public function actionCreate() {
        $receive = $this->instantiate(null);
        $receive->header->date = date('Y-m-d');
        $receive->header->admin_id = Yii::app()->user->id;
        
        $productSize = Search::bind(new ProductSize('search'), isset($_GET['ProductSize']) ? $_GET['ProductSize'] : array());
        //assign custom attribute for search
        $productSize->productName = isset($_GET['ProductSize']['productName']) ? $_GET['ProductSize']['productName'] : '';
        $productSize->productCategoryId = isset($_GET['ProductSize']['productCategoryId']) ? $_GET['ProductSize']['productCategoryId'] : '';
        $productSizeDataProvider = $productSize->searchForPurchase();
        $productSizeDataProvider->criteria->compare('height', $productSize->height);
        $productSizeDataProvider->criteria->compare('width', $productSize->width);

        $purchaseHeader = Search::bind(new PurchaseHeader('search'), isset($_GET['PurchaseHeader']) ? $_GET['PurchaseHeader'] : array());

        $supplierCompany = isset($_GET['SupplierCompany']) ? $_GET['SupplierCompany'] : '';

        $purchaseHeaderDataProvider = $purchaseHeader->searchByReceive();
        $purchaseHeaderDataProvider->criteria->with = array(
            'supplier',
        );

        $supplier = Search::bind(new Supplier('search'), isset($_GET['Supplier']) ? $_GET['Supplier'] : array());
        $supplierDataProvider = $supplier->search();
        $supplierDataProvider->criteria->compare('t.is_inactive', 0);

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($receive);
            $receive->generateCodeNumber(Yii::app()->dateFormatter->format('M', strtotime($receive->header->date)), Yii::app()->dateFormatter->format('yy', strtotime($receive->header->date)));
            
            if ($receive->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $receive->header->id));
        }

        $this->render('create', array(
            'receive' => $receive,
            'purchaseHeader' => $purchaseHeader,
            'purchaseHeaderDataProvider' => $purchaseHeaderDataProvider,
            'supplierCompany' => $supplierCompany,
            'productSize' => $productSize,
            'productSizeDataProvider' => $productSizeDataProvider,
            'supplier' => $supplier,
            'supplierDataProvider' => $supplierDataProvider,
        ));
    }

    public function actionUpdate($id) {
        set_time_limit(0);
        ini_set('memory_limit', '1024M');
        
        $receive = $this->instantiate($id);

        $receive->header->admin_id = 1;

        $productSize = Search::bind(new ProductSize('search'), isset($_GET['ProductSize']) ? $_GET['ProductSize'] : array());
        //assign custom attribute for search
        $productSize->productName = isset($_GET['ProductSize']['productName']) ? $_GET['ProductSize']['productName'] : '';
        $productSize->productCategoryId = isset($_GET['ProductSize']['productCategoryId']) ? $_GET['ProductSize']['productCategoryId'] : '';
        $productSizeDataProvider = $productSize->searchForPurchase();
        $productSizeDataProvider->criteria->compare('height', $productSize->height);
        $productSizeDataProvider->criteria->compare('width', $productSize->width);

        if (isset($_POST['purchase_header_id'])) {         //to prevent header id loss when details saving are failed, but the header is successfully saved. Example: all zero quantity details saving
            $delivery->header->sale_header_id = $_POST['sale_header_id'];
        }

        $purchaseHeader = Search::bind(new PurchaseHeader('search'), isset($_GET['PurchaseHeader']) ? $_GET['PurchaseHeader'] : array());

        $cnMonth = isset($_GET['CnMonth']) ? $_GET['CnMonth'] : '';
        $purchaseHeader->normalizeCnMonthBy($cnMonth);
        $purchaseHeaderDataProvider = $purchaseHeader->searchByReceive();

        $supplier = Search::bind(new Supplier('search'), isset($_GET['Supplier']) ? $_GET['Supplier'] : array());
        $supplierDataProvider = $supplier->search();
        $supplierDataProvider->criteria->compare('t.is_inactive', 0);

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($receive);
            if ($receive->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $receive->header->id));
        }

        $this->render('update', array(
            'receive' => $receive,
            'purchaseHeader' => $purchaseHeader,
            'purchaseHeaderDataProvider' => $purchaseHeaderDataProvider,
            'cnMonth' => strtoupper($cnMonth),
            'productSize' => $productSize,
            'productSizeDataProvider' => $productSizeDataProvider,
            'supplier' => $supplier,
            'supplierDataProvider' => $supplierDataProvider,
        ));
    }

    public function actionDelete($id) {
        if (Yii::app()->request->isPostRequest) {
            $receive = $this->loadModel($id);
            if ($receive !== null) {
                $receive->is_inactive = ActiveRecord::INACTIVE;
                $receive->update(array('is_inactive'));
                
                foreach ($receive->receiveDetails as $detail) {
                    $detail->is_inactive = ActiveRecord::INACTIVE;
                    $detail->update(array('is_inactive'));
                }
            }

            if (!isset($_GET['ajax']))
                $this->redirect(isset($_POST['returnUrl']) ? $_POST['returnUrl'] : array('admin'));
        }
        else
            throw new CHttpException(400, 'Invalid request. Please do not repeat this request again.');
    }

    public function actionView($id) {
        $receive = $this->loadModel($id);

        $criteria = new CDbCriteria;
        $criteria->compare('receive_header_id', $receive->id);
        $detailsDataProvider = new CActiveDataProvider('ReceiveDetail', array(
                    'criteria' => $criteria,
                ));

        $this->render('view', array(
            'receive' => $receive,
            'detailsDataProvider' => $detailsDataProvider,
        ));
    }

    public function actionMemo($id) {
        $receive = $this->loadModel($id);

        $this->render('memo', array(
            'receive' => $receive,
        ));
    }

    public function actionAdmin() {
        $receive = Search::bind(new ReceiveHeader('search'), isset($_GET['ReceiveHeader']) ? $_GET['ReceiveHeader'] : array());
        $supplierCompany = isset($_GET['SupplierCompany']) ? $_GET['SupplierCompany'] : '';
        $purchase = Search::bind(new PurchaseHeader('search'), isset($_GET['PurchaseHeader']) ? $_GET['PurchaseHeader'] : array());

        $purchaseCnOrdinal = isset($_GET['PurchaseCnOrdinal']) ? $_GET['PurchaseCnOrdinal'] : '';
        $purchaseCnMonth = isset($_GET['PurchaseCnMonth']) ? $_GET['PurchaseCnMonth'] : '';
        $purchaseCnYear = isset($_GET['PurchaseCnYear']) ? $_GET['PurchaseCnYear'] : '';

        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }

        $dataProvider = $receive->searchWithPaging();
        //$dataProvider = ReceiveHeader::searchByPurchaseOrder($receive, $purchase);
        $dataProvider->criteria->with = array(
            'purchaseHeader',
            'supplier'
        );
//        $dataProvider->sort->attributes = array(
//            'id' => 't.id',
//            'date' => 't.date',
//            'purchaseHeaderId' => 'purchaseHeader.id',
//            'supplierCompanyName' => 'supplier.company',
//        );

        if ($purchaseCnOrdinal != null || $purchaseCnMonth != null || $purchaseCnYear != null) {
            $dataProvider->criteria->compare('purchaseHeader.cn_ordinal', $purchaseCnOrdinal);
            $dataProvider->criteria->compare('purchaseHeader.cn_month', $purchaseCnMonth);
            $dataProvider->criteria->compare('purchaseHeader.cn_year', $purchaseCnYear);
        }

        if ($supplierCompany != null) {
            $dataProvider->criteria->addCondition("supplier.company LIKE :company");
            $dataProvider->criteria->params[':company'] = "%{$supplierCompany}%";
        }

        $startDate = (isset($_GET['StartDate'])) ? $_GET['StartDate'] : '';
        $endDate = (isset($_GET['EndDate'])) ? $_GET['EndDate'] : '';

        if ($startDate != '' || $endDate != '') {
            $startDate = (empty($startDate)) ? date('Y-m-d') : $startDate;
            $endDate = (empty($endDate)) ? date('Y-m-d') : $endDate;

            $dataProvider->criteria->addBetweenCondition('t.date', $startDate, $endDate);
        }

        $dataProvider->criteria->addCondition('t.is_inactive = 0');
        $dataProvider->criteria->order = 't.id DESC';

        $this->render('admin', array(
            'receive' => $receive,
            'dataProvider' => $dataProvider,
            'supplierCompany' => $supplierCompany,
            'purchase' => $purchase,
            'purchaseCnOrdinal' => $purchaseCnOrdinal,
            'purchaseCnMonth' => $purchaseCnMonth,
            'purchaseCnYear' => $purchaseCnYear,
        ));
    }

    public function actionAjaxHtmlRemoveDetail($index, $id) {
        if (Yii::app()->request->isAjaxRequest) {
            $receive = $this->instantiate($id);
            $this->loadState($receive);

            $receive->removeDetailAt($index);

            $this->renderPartial('_detail', array(
                'receive' => $receive,
                'error' => false,
            ));
        }
    }

    public function actionAjaxJsonPurchase($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $receive = $this->instantiate($id);
            $this->loadState($receive);

            $purchaseHeader = PurchaseHeader::model()->findByPk($_POST['ReceiveHeader']['purchase_header_id']);

            $object = array(
                'purchase_header_code_number' => ($purchaseHeader === null) ? '' : $purchaseHeader->getCodeNumber(PurchaseHeader::CN_CONSTANT),
                'purchase_header_date' => CHtml::encode(Yii::app()->dateFormatter->format('d MMMM yyyy', strtotime(CHtml::value($purchaseHeader, 'date')))),
                'supplier_company' => $purchaseHeader->supplier->company,
            );

            echo CJSON::encode($object);
        }
    }

    public function actionAjaxHtmlShowPurchase($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $receive = $this->instantiate($id);
            $this->loadState($receive);

            if (isset($_POST['ReceiveHeader']['purchase_header_id']))
                $receive->addDetailByPurchase($_POST['ReceiveHeader']['purchase_header_id']);

            $this->renderPartial('_detail', array(
                'receive' => $receive,
            ));
        }
    }

    public function actionAjaxHtmlResetDetail($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $receive = $this->instantiate($id);
            $this->loadState($receive);


            $receive->details = array();

            $this->renderPartial('_detail', array(
                'receive' => $receive,
            ));
        }
    }

    public function actionAjaxHtmlAddProduct($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $receive = $this->instantiate($id);

            $this->loadState($receive);

            $quantity = isset($_POST['Quantity']) ? $_POST['Quantity'] : 0;
            $productName = isset($_POST['ProductName']) ? $_POST['ProductName'] : '';
            $productCategoryId = isset($_POST['ProductCategoryId']) ? $_POST['ProductCategoryId'] : '';
            $height = isset($_POST['Height']) ? $_POST['Height'] : '0.00';
            $width = isset($_POST['Width']) ? $_POST['Width'] : '0.00';
            $length = isset($_POST['Length']) ? $_POST['Length'] : '0.00';
            $weightPacking = isset($_POST['WeightPacking']) ? $_POST['WeightPacking'] : '0.00';
            $locationId = isset($_POST['LocationId']) ? $_POST['LocationId'] : '';
            $memo = isset($_POST['Memo']) ? $_POST['Memo'] : '';
            if (!empty($productName) && !empty($productCategoryId) && !empty($height) && !empty($length) && !empty($locationId)) {
                for ($i = 0; $i < $quantity; $i++) {
                    $receiveDetail = new ReceiveDetail();
                    $receiveDetail->product_name = $productName;
                    $receiveDetail->product_category_id = $productCategoryId;
                    $receiveDetail->height = $height;
                    $receiveDetail->width = $width;
                    $receiveDetail->length = $length;
                    $receiveDetail->weight_packing = $weightPacking;
                    $receiveDetail->weight = $receiveDetail->getWeightRequestForReceive();
                    $receiveDetail->location_id = $locationId;
                    $receiveDetail->memo = $memo;
                    $receive->details[] = $receiveDetail;
                }
            }

//            if (isset($_POST['ProductSizeId']))
//                $receive->addDetail($_POST['ProductSizeId']);

            $this->renderPartial('_detail', array(
                'receive' => $receive,
            ));
        }
    }

    public function actionAjaxJsonGetProductWeightRequest($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $receive = $this->instantiate($id);
            $this->loadState($receive);

            $object = array(
                'weight' => CHtml::encode(CHtml::value($receive->details[$index], 'weightRequestForReceive')),
                'weightFormatted' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.####', CHtml::value($receive->details[$index], 'weightRequestForReceive'))),
            );

            echo CJSON::encode($object);
        }
    }

    public function actionAjaxJsonSupplier($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $supplierId = (isset($_POST['ReceiveHeader']['supplier_id'])) ? $_POST['ReceiveHeader']['supplier_id'] : '';

            $supplier = Supplier::model()->findByPk($supplierId);

            $object = array(
                'supplier_id' => CHtml::value($supplier, 'id'),
                'supplier_name' => CHtml::value($supplier, 'name'),
                'supplier_company' => CHtml::value($supplier, 'company'),
                'supplier_address' => nl2br(CHtml::value($supplier, 'address_main')),
            );
            echo CJSON::encode($object);
        }
    }

    public function instantiate($id) {
        if (empty($id))
            $receive = new Receive(new ReceiveHeader(), array());
        else {
            $receiveHeader = $this->loadModel($id);
            $receive = new Receive($receiveHeader, $receiveHeader->receiveDetails);
        }

        return $receive;
    }

    public function loadModel($id) {
        $model = ReceiveHeader::model()->findByPk($id);
        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        return $model;
    }

    protected function loadState(&$receive) {
        if (isset($_POST['ReceiveHeader'])) {
            $receive->header->attributes = $_POST['ReceiveHeader'];
        }

        if (isset($_POST['ReceiveDetail'])) {
            foreach ($_POST['ReceiveDetail'] as $i => $item) {
                if (isset($receive->details[$i]))
                    $receive->details[$i]->attributes = $item;
                else {
                    $detail = new ReceiveDetail();
                    $detail->attributes = $item;
                    $receive->details[] = $detail;
                }
            }
            if (count($_POST['ReceiveDetail']) < count($receive->details))
                array_splice($receive->details, $i + 1);
        }
        else
            $receive->details = array();
    }

}

