<?php

/**
 * @property integer $id
 * @property integer $cn_ordinal
 * @property integer $cn_month
 * @property integer $cn_year
 * @property string $date
 * @property string $estimate_receive_date
 * @property string $discount
 * @property string $downpayment
 * @property string $exchange_rate
 * @property string $note
 * @property integer $delivery_period
 * @property integer $payment_period
 * @property integer $valid_period
 * @property integer $supplier_id
 * @property integer $currency_id
 * @property integer $admin_id
 * @property integer $admin_purchasing_id
 * @property integer $admin_accounting_id
 * @property integer $admin_finance_id
 * @property integer $is_import
 * @property integer $is_tax
 * @property integer $is_tax_income
 * @property integer $is_confirmed
 * @property integer $is_service
 * @property integer $is_inactive
 * @property integer $tax_percentage
 *
 * @property PurchaseDetail[] $purchaseDetails
 * @property PurchaseDetailService[] $purchaseDetailServices
 * @property Supplier $supplier
 * @property Currency $currency
 * @property Admin $admin
 * @property ReceiveHeader[] $receiveHeaders
 */
class PurchaseHeaderBase extends MonthlyTransactionActiveRecord {

    public function tableName() {
        return 'tblsp_purchase_header';
    }

    public function rules() {
        return array(
            array('cn_ordinal, cn_month, cn_year, date, supplier_id, currency_id, admin_id, admin_purchasing_id, admin_accounting_id, admin_finance_id', 'required'),
            array('cn_ordinal, cn_month, cn_year, delivery_period, payment_period, valid_period, supplier_id, currency_id, admin_id, is_import, is_tax, is_tax_income, is_confirmed, is_service, is_inactive, tax_percentage, admin_purchasing_id, admin_accounting_id, admin_finance_id', 'numerical', 'integerOnly' => true),
            array('discount, downpayment, exchange_rate', 'length', 'max' => 18),
            array('estimate_receive_date, note', 'safe'),
            // The following rule is used by search().
            array('id, cn_ordinal, cn_month, cn_year, date, estimate_receive_date, discount, downpayment, exchange_rate, note, delivery_period, payment_period, valid_period, supplier_id, currency_id, admin_id, is_import, is_tax, is_tax_income, is_confirmed, is_service, is_inactive, tax_percentage, admin_purchasing_id, admin_accounting_id, admin_finance_id', 'safe', 'on' => 'search'),
        );
    }

    public function relations() {
        return array(
            'purchaseDetails' => array(self::HAS_MANY, 'PurchaseDetail', 'purchase_header_id'),
            'purchaseDetailServices' => array(self::HAS_MANY, 'PurchaseDetailService', 'purchase_header_id'),
            'supplier' => array(self::BELONGS_TO, 'Supplier', 'supplier_id'),
            'currency' => array(self::BELONGS_TO, 'Currency', 'currency_id'),
            'admin' => array(self::BELONGS_TO, 'Admin', 'admin_id'),
            'adminPurchasing' => array(self::BELONGS_TO, 'Admin', 'admin_purchasing_id'),
            'adminAccounting' => array(self::BELONGS_TO, 'Admin', 'admin_accounting_id'),
            'adminFinance' => array(self::BELONGS_TO, 'Admin', 'admin_finance_id'),
            'receiveHeaders' => array(self::HAS_MANY, 'ReceiveHeader', 'purchase_header_id'),
        );
    }

    public function attributeLabels() {
        return array(
            'id' => 'ID',
            'cn_ordinal' => 'Cn Ordinal',
            'cn_month' => 'Cn Month',
            'cn_year' => 'Cn Year',
            'date' => 'Date',
            'estimate_receive_date' => 'Estimate Receive Date',
            'discount' => 'Discount',
            'downpayment' => 'Downpayment',
            'exchange_rate' => 'Exchange Rate',
            'note' => 'Note',
            'delivery_period' => 'Delivery Period',
            'payment_period' => 'Payment Period',
            'valid_period' => 'Valid Period',
            'supplier_id' => 'Supplier',
            'currency_id' => 'Currency',
            'admin_id' => 'Admin',
            'is_import' => 'Is Import',
            'is_tax' => 'Is Tax',
            'is_tax_income' => 'Is Tax Income',
            'is_confirmed' => 'Is Confirmed',
            'is_service' => 'Is Service',
            'is_inactive' => 'Is Inactive',
            'tax_percentage' => 'Tax Percentage',
        );
    }

    public function search() {
        $criteria = new CDbCriteria;

        $criteria->compare('t.id', $this->id);
        $criteria->compare('t.cn_ordinal', $this->cn_ordinal);
        $criteria->compare('t.cn_month', $this->cn_month);
        $criteria->compare('t.cn_year', $this->cn_year);
        $criteria->compare('t.date', $this->date, true);
        $criteria->compare('t.estimate_receive_date', $this->estimate_receive_date, true);
        $criteria->compare('t.discount', $this->discount, true);
        $criteria->compare('t.downpayment', $this->downpayment, true);
        $criteria->compare('t.exchange_rate', $this->exchange_rate, true);
        $criteria->compare('t.note', $this->note, true);
        $criteria->compare('t.delivery_period', $this->delivery_period);
        $criteria->compare('t.payment_period', $this->payment_period);
        $criteria->compare('t.valid_period', $this->valid_period);
        $criteria->compare('t.supplier_id', $this->supplier_id);
        $criteria->compare('t.currency_id', $this->currency_id);
        $criteria->compare('t.admin_id', $this->admin_id);
        $criteria->compare('t.is_import', $this->is_import);
        $criteria->compare('t.is_tax', $this->is_tax);
        $criteria->compare('t.is_tax_income', $this->is_tax_income);
        $criteria->compare('t.is_confirmed', $this->is_confirmed);
        $criteria->compare('t.is_service', $this->is_service);
        $criteria->compare('t.is_inactive', $this->is_inactive);
        $criteria->compare('t.tax_percentage', $this->tax_percentage);

        return new CActiveDataProvider($this, array(
            'criteria' => $criteria,
            'pagination' => array(
                'pageSize' => 100,
            ),
        ));
    }

}
