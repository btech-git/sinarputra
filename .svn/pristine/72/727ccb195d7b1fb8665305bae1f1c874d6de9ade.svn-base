    <?php foreach ($stockCheckSummary->dataProvider->data as $detail): ?>
        <tr class="items1">
            <td class="width1-1" style="border-bottom: 1px solid #555;">
                <?php echo CHtml::encode(CHtml::value($detail, 'serialConstant')); ?>
            </td>
            <td class="width1-2" style="border-bottom: 1px solid #555;">
                <?php echo CHtml::encode(CHtml::value($detail, 'product.code')); ?>
            </td>
            <td class="width1-3" style="border-bottom: 1px solid #555;">
                <?php echo CHtml::encode(CHtml::value($detail, 'product_name')); ?>
            </td>
            <td class="width1-4" style="border-bottom: 1px solid #555;">
                <?php echo CHtml::encode(CHtml::value($detail, 'productCategory.name')); ?>
            </td>
            <td class="width1-5" style="border-bottom: 1px solid #555; ">
                <?php echo CHtml::encode(Yii::app()->numberFormatter->format("#,##0.00", $detail->height)); ?>
            </td>
            <td class="width1-6" style="border-bottom: 1px solid #555; ">
                <?php echo CHtml::encode(Yii::app()->numberFormatter->format("#,##0.00", $detail->width)); ?>
            </td>
            <td class="width1-7" style="border-bottom: 1px solid #555; ">
                <?php echo CHtml::encode(Yii::app()->numberFormatter->format("#,##0.00", $detail->length)); ?>
            </td>
            <td class="width1-8" style="border-bottom: 1px solid #555; ">
                <?php echo CHtml::encode(Yii::app()->numberFormatter->format("#,##0.00", $detail->weight)); ?>
            </td>
            <td class="width1-9" style="border-bottom: 1px solid #555; ">
                <?php echo CHtml::encode(Yii::app()->numberFormatter->format("#,##0.00", $detail->weight_packing)); ?>
            </td>
            <td class="width1-10" style="border-bottom: 1px solid #555;">
                <?php echo CHtml::encode(CHtml::value($detail, 'location.name')); ?>
            </td>
        </tr>
    <?php endforeach; ?>
</table>