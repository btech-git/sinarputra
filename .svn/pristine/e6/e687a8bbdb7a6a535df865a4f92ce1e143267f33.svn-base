<?php

class PurchaseItemController extends Controller {

    public function filters() {
        return array(
			'access',
        );
    }
    
    public function filterAccess($filterChain) {
        if ($filterChain->action->id === 'create') {
            if (!(Yii::app()->user->checkAccess('purchaseCreate')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'delete' || $filterChain->action->id === 'update') {
            if (!(Yii::app()->user->checkAccess('purchaseEdit')))
                $this->redirect(array('/site/login'));
        }
        if ($filterChain->action->id === 'admin'
                || $filterChain->action->id === 'memo'
                || $filterChain->action->id === 'view') {
            if (!(Yii::app()->user->checkAccess('purchaseCreate') || Yii::app()->user->checkAccess('purchaseEdit')))
                $this->redirect(array('/site/login'));
        }

        $filterChain->run();
    }


    public function actionCreate() {
        $purchaseItem = $this->instantiate(null);
        $purchaseItem->header->date = date('Y-m-d');
	$purchaseItem->header->is_tax = 1;
        $purchaseItem->header->admin_id = Yii::app()->user->id;
        $purchaseItem->header->admin_purchasing_id = 66;
        $purchaseItem->header->admin_accounting_id = 23;
        $purchaseItem->header->admin_finance_id = 16;

        $item = Search::bind(new Item('search'), isset($_GET['Item']) ? $_GET['Item'] : array());
        $itemDataProvider = $item->searchForPurchaseItem();

        $supplier = Search::bind(new Supplier('search'), isset($_GET['Supplier']) ? $_GET['Supplier'] : array());
        $supplierDataProvider = $supplier->search();
        $supplierDataProvider->criteria->compare('t.is_inactive', 0);

        if (isset($_POST['Submit']) && IdempotentManager::check()) {
            $this->loadState($purchaseItem);
            $purchaseItem->generateCodeNumber(Yii::app()->dateFormatter->format('M', strtotime($purchaseItem->header->date)), Yii::app()->dateFormatter->format('yy', strtotime($purchaseItem->header->date)));
            
            if ($purchaseItem->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $purchaseItem->header->id));
        }

        $this->render('create', array(
            'purchaseItem' => $purchaseItem,
            'supplier' => $supplier,
            'supplierDataProvider' => $supplierDataProvider,
            'item' => $item,
            'itemDataProvider' => $itemDataProvider,
        ));
    }

    public function actionUpdate($id) {
        $purchaseItem = $this->instantiate($id);

        $item = Search::bind(new Item('search'), isset($_GET['Item']) ? $_GET['Item'] : array());
        $itemDataProvider = $item->searchForPurchaseItem();

        $supplier = Search::bind(new Supplier('search'), isset($_GET['Supplier']) ? $_GET['Supplier'] : array());
        $supplierDataProvider = $supplier->search();
        $supplierDataProvider->criteria->compare('t.is_inactive', 0);


        if (isset($_POST['Submit'])) {
            $this->loadState($purchaseItem);
            if ($purchaseItem->save(Yii::app()->db))
                $this->redirect(array('view', 'id' => $purchaseItem->header->id));
        }

        $this->render('update', array(
            'purchaseItem' => $purchaseItem,
            'supplier' => $supplier,
            'supplierDataProvider' => $supplierDataProvider,
            'item' => $item,
            'itemDataProvider' => $itemDataProvider,
        ));
    }

    public function actionView($id) {
        $purchaseItem = $this->loadModel($id);

        $criteria = new CDbCriteria;
        $criteria->compare('t.purchase_item_header_id', $purchaseItem->id);
        $detailsDataProvider = new CActiveDataProvider('PurchaseItemDetail', array(
            'criteria' => $criteria,
        ));

        $this->render('view', array(
            'purchaseItem' => $purchaseItem,
            'detailsDataProvider' => $detailsDataProvider,
        ));
    }

    public function actionMemo($id) {
        $purchaseItem = $this->loadModel($id);

        $this->render('memo', array(
            'purchaseItem' => $purchaseItem,
        ));
    }

    public function actionAdmin() {
        $purchaseItem = Search::bind(new PurchaseItemHeader('search'), isset($_GET['PurchaseItemHeader']) ? $_GET['PurchaseItemHeader'] : array());

        if (isset($_GET['pageSize'])) {
            Yii::app()->user->setState('pageSize', (int) $_GET['pageSize']);
            unset($_GET['pageSize']);
        }
        
        $dataProvider = $purchaseItem->searchWithPaging();


//        $dataProvider->sort->attributes = array(
//            'id' => 't.id',
//            'date' => 't.date',
//            'supplierCompany' => 'supplier.company'
//        );

        $dataProvider->criteria->addCondition('t.is_inactive = 0');
        $dataProvider->criteria->order = 't.id DESC';

        $this->render('admin', array(
            'purchaseItem' => $purchaseItem,
            'dataProvider' => $dataProvider,
        ));
    }

    public function actionDelete($id) {
        if (Yii::app()->request->isPostRequest) {
            $purchase = $this->loadModel($id);
            if ($purchase !== null) {
                $purchase->is_inactive = ActiveRecord::INACTIVE;
                $purchase->update(array('is_inactive'));
                
                foreach ($purchase->purchaseItemDetails as $detail) {
                    $detail->is_inactive = ActiveRecord::INACTIVE;
                    $detail->update(array('is_inactive'));
                }
            }

            if (!isset($_GET['ajax']))
                $this->redirect(isset($_POST['returnUrl']) ? $_POST['returnUrl'] : array('admin'));
        }
        else
            throw new CHttpException(400, 'Invalid request. Please do not repeat this request again.');
    }

    public function actionAjaxJsonSupplier($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $supplierId = (isset($_POST['PurchaseItemHeader']['supplier_id'])) ? $_POST['PurchaseItemHeader']['supplier_id'] : '';

            $supplier = Supplier::model()->findByPk($supplierId);

            $object = array(
                'supplier_id' => CHtml::value($supplier, 'id'),
                'supplier_name' => CHtml::value($supplier, 'name'),
                'supplier_company' => CHtml::value($supplier, 'company'),
                'supplier_address' => nl2br(CHtml::value($supplier, 'address_main')),
            );
            echo CJSON::encode($object);
        }
    }

    public function actionAjaxJsonTotal($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchaseItem = $this->instantiate($id);
            $this->loadState($purchaseItem);

            $object = array(
                'total' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', CHtml::value($purchaseItem->details[$index], 'total'))),
                'subTotal' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $purchaseItem->subTotal)),
                'calculatedTax' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $purchaseItem->calculatedTax)),
                'calculatedTaxIncome' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $purchaseItem->calculatedTaxIncome)),
                'grandTotal' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $purchaseItem->grandTotal)),
            );

            echo CJSON::encode($object);
        }
    }

    public function actionAjaxJsonGrandTotal($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchaseItem = $this->instantiate($id);
            $this->loadState($purchaseItem);

            $object = array(
                'taxValue' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $purchaseItem->getCalculatedTax())),
                'taxIncomeValue' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $purchaseItem->getCalculatedTaxIncome())),
                'grandTotal' => CHtml::encode(Yii::app()->numberFormatter->format('#,##0.00', $purchaseItem->getGrandTotal())),
            );

            echo CJSON::encode($object);
        }
    }

    public function actionAjaxHtmlResetDetail($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchase = $this->instantiate($id);

            $this->loadState($purchase);

            $type = Yii::app()->request->getParam('type');


            if ($type == 1) {
                $purchase->details = array();
                $purchase->purchaseDetailServices = array();

                $this->renderPartial('_detail', array(
                    'purchase' => $purchase,
                ));
            } else {
                $purchase->details = array();
                $purchase->purchaseDetailServices = array();

                $this->renderPartial('_service', array(
                    'purchase' => $purchase,
                ));
            }
        }
    }

    public function actionAjaxHtmlAddItem($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchaseItem = $this->instantiate($id);

            $this->loadState($purchaseItem);

            if (isset($_POST['ItemId']))
                $purchaseItem->addDetail($_POST['ItemId']);

            $this->renderPartial('_detail', array(
                'purchaseItem' => $purchaseItem,
            ));
        }
    }

    public function actionAjaxHtmlRemoveItem($id, $index) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchaseItem = $this->instantiate($id);

            $this->loadState($purchaseItem);

            $purchaseItem->removeDetailAt($index);

            $this->renderPartial('_detail', array(
                'purchaseItem' => $purchaseItem,
            ));
        }
    }

    public function actionAjaxHtmlUpdateProducts($id) {
        if (Yii::app()->request->isAjaxRequest) {
            $purchase = $this->instantiate($id);

            $this->loadState($purchase);

            $this->renderPartial('_detail', array(
                'purchase' => $purchase,
            ));
        }
    }

    public function instantiate($id) {
        if (empty($id))
            $purchaseItem = new PurchaseItem(new PurchaseItemHeader(), array());
        else {
            $purchaseItemHeader = $this->loadModel($id);
            $purchaseItem = new PurchaseItem($purchaseItemHeader, $purchaseItemHeader->purchaseItemDetails);
        }

        return $purchaseItem;
    }

    public function loadModel($id) {
        $model = PurchaseItemHeader::model()->findByPk($id);
        if ($model === null)
            throw new CHttpException(404, 'The requested page does not exist.');
        return $model;
    }

    public function loadState($purchaseItem) {
        if (isset($_POST['PurchaseItemHeader'])) {
            $purchaseItem->header->attributes = $_POST['PurchaseItemHeader'];
        }

        if (isset($_POST['PurchaseItemDetail'])) {
            foreach ($_POST['PurchaseItemDetail'] as $i => $item) {
                if (isset($purchaseItem->details[$i]))
                    $purchaseItem->details[$i]->attributes = $item;
                else {
                    $detail = new PurchaseItemDetail();
                    $detail->attributes = $item;
                    $purchaseItem->details[] = $detail;
                }
            }
            if (count($_POST['PurchaseItemDetail']) < count($purchaseItem->details))
                array_splice($purchaseItem->details, $i + 1);
        }
        else
            $purchaseItem->details = array();
    }

}
